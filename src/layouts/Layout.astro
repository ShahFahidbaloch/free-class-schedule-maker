---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  schemaJson?: object;
}

const {
  title = "Class Schedule — College Timetable & Gap Optimizer",
  description = "Free interactive Class Schedule Maker and Timetable Optimizer. Eliminate awkward campus gaps and export conflict-free schedules to Apple & Google Calendar.",
  canonicalUrl = Astro.url.href,
  schemaJson
} = Astro.props;

const siteName = "Class Schedule";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    
    <!-- Theme Detection -->
    <script is:inline>
      (function() {
        var savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch (e) {}
        if (savedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-[#fafafa] dark:bg-[#09090b] text-zinc-900 dark:text-zinc-100 antialiased selection:bg-zinc-900 selection:text-white dark:selection:bg-white dark:selection:text-zinc-950 transition-colors duration-150">
    <!-- Navbar with Official Logo -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/85 dark:bg-[#09090b]/85 border-b border-zinc-200/90 dark:border-zinc-800/90 transition-colors">
      <div class="max-w-[1536px] mx-auto px-3 sm:px-6 h-14 flex items-center justify-between">
        
        <!-- Logo & Brand Name -->
        <a href="/" class="flex items-center gap-2.5 group">
          <img 
            src="/logo.png" 
            alt="Class Schedule Logo" 
            class="w-8 h-8 rounded-lg shadow-2xs group-hover:scale-105 transition-transform object-cover" 
          />
          <div class="flex flex-col">
            <span class="text-sm font-bold tracking-tight text-zinc-900 dark:text-white leading-none">
              Class Schedule
            </span>
            <span class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400 leading-tight">
              Timetable Optimizer
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-zinc-600 dark:text-zinc-400">
          <a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Schedule Maker</a>
          <a href="#planning-guide" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Planning Guide</a>
          <a href="#faq" class="hover:text-zinc-900 dark:hover:text-white transition-colors">FAQ</a>
          <a href="/blog" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Articles</a>
        </nav>

        <!-- Right Quick Actions -->
        <div class="flex items-center gap-2">
          <!-- Quick Print Button (Desktop) -->
          <button 
            type="button"
            onclick="window.print()"
            class="hidden sm:inline-flex items-center gap-1.5 h-8 px-2.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-xs font-medium text-zinc-700 dark:text-zinc-300 transition shadow-2xs cursor-pointer"
            title="Print schedule sheet"
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H7v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
            </svg>
            <span>Print</span>
          </button>

          <!-- Theme Toggle -->
          <button 
            id="theme-toggle" 
            type="button"
            aria-label="Toggle visual theme"
            class="w-8 h-8 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 flex items-center justify-center text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition cursor-pointer"
          >
            <svg id="theme-sun" class="w-4 h-4 hidden dark:block text-zinc-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="theme-moon" class="w-4 h-4 block dark:hidden text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Workspace -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#09090b] text-xs text-zinc-500 dark:text-zinc-400 py-8 mt-12">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px]">
        <div class="flex items-center gap-3">
          <img src="/logo.png" alt="Class Schedule" class="w-5 h-5 rounded object-cover" />
          <span class="font-bold text-zinc-900 dark:text-white">Class Schedule</span>
          <span>•</span>
          <a href="/about" class="hover:underline">About</a>
          <a href="/privacy-policy" class="hover:underline">Privacy Policy</a>
          <a href="/terms-of-service" class="hover:underline">Terms of Service</a>
          <a href="/contact" class="hover:underline">Contact</a>
        </div>
        <div class="flex items-center gap-3 text-zinc-400">
          <span>Client-Side Privacy</span>
          <span>•</span>
          <span>Zero Server Tracking</span>
        </div>
      </div>
    </footer>

    <!-- Theme Toggle & Anchor Navigation Script -->
    <script is:inline>
      (function() {
        // Theme Toggle
        var btn = document.getElementById('theme-toggle');
        if (btn) {
          btn.addEventListener('click', function() {
            var isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
              document.documentElement.classList.remove('dark');
              try { localStorage.setItem('theme', 'light'); } catch(e) {}
            } else {
              document.documentElement.classList.add('dark');
              try { localStorage.setItem('theme', 'dark'); } catch(e) {}
            }
          });
        }

        // Anchor navigation for FAQ & Planning Guide
        function openAndScroll(hash) {
          if (!hash || (hash !== '#planning-guide' && hash !== '#faq')) return;
          var hub = document.getElementById('editorial-hub');
          if (hub) {
            hub.open = true;
          }
          setTimeout(function() {
            var target = document.querySelector(hash);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth' });
            }
          }, 60);
        }

        document.addEventListener('click', function(e) {
          var link = e.target.closest('a');
          if (link && link.getAttribute('href') && link.getAttribute('href').startsWith('#')) {
            var hash = link.getAttribute('href');
            if (hash === '#planning-guide' || hash === '#faq') {
              e.preventDefault();
              openAndScroll(hash);
            }
          }
        });

        if (window.location.hash) {
          openAndScroll(window.location.hash);
        }
      })();
    </script>
  </body>
</html>
