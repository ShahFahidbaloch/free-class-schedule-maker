---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  schemaJson?: object;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  schemaJson
} = Astro.props;

const siteName = "Class Schedule Maker & Gap Optimizer";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Theme Detection Script (Eliminates Flash) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <!-- Schema.org JSON-LD -->
    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}
    
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": siteName,
      "url": "https://classscheduleoptimizer.com",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All modern browsers",
      "description": "High-performance interactive class schedule maker and dead time gap optimizer for college and university students.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    })} />
  </head>
  <body class="min-h-screen flex flex-col bg-[#FBFBFD] dark:bg-[#0A0A0C] text-zinc-900 dark:text-zinc-100 antialiased selection:bg-zinc-900 selection:text-white dark:selection:bg-white dark:selection:text-zinc-900">
    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-[#0A0A0C]/80 border-b border-zinc-200/80 dark:border-zinc-800/80 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-zinc-900 dark:bg-white flex items-center justify-center text-white dark:text-zinc-950 font-semibold text-sm shadow-sm transition-transform group-hover:scale-105">
            CS
          </div>
          <div class="flex flex-col">
            <span class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-white leading-none">ScheduleMaker</span>
            <span class="text-[11px] text-zinc-500 dark:text-zinc-400 font-normal leading-tight">Gap Optimizer</span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-zinc-600 dark:text-zinc-300">
          <a href="/" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Optimizer</a>
          <a href="/blog" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Guides & Science</a>
          <a href="/about" class="hover:text-zinc-950 dark:hover:text-white transition-colors">About</a>
          <a href="/contact" class="hover:text-zinc-950 dark:hover:text-white transition-colors">Contact</a>
        </nav>

        <div class="flex items-center gap-3">
          <!-- Dark / Light Mode Toggle Button -->
          <button 
            id="theme-toggle" 
            aria-label="Toggle visual theme"
            class="w-9 h-9 rounded-xl border border-zinc-200 dark:border-zinc-800 flex items-center justify-center text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
          >
            <svg id="theme-sun" class="w-4 h-4 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="theme-moon" class="w-4 h-4 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <!-- Status Tag -->
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-emerald-50 dark:bg-emerald-950/40 text-emerald-800 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/80 shadow-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            100% Free Open Utility
          </span>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Site Footer -->
    <footer class="mt-20 border-t border-zinc-200/80 dark:border-zinc-800/80 bg-white/60 dark:bg-[#0A0A0C]/60 text-xs text-zinc-500 dark:text-zinc-400">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <div class="w-6 h-6 rounded-md bg-zinc-900 dark:bg-white flex items-center justify-center text-white dark:text-zinc-950 font-semibold text-xs">
                CS
              </div>
              <span class="font-semibold text-zinc-900 dark:text-white">Class Schedule Optimizer</span>
            </div>
            <p class="leading-relaxed">
              Algorithmic college timetable planning tool designed to eliminate awkward dead hours, optimize daily credit loads, and reduce student cognitive fatigue.
            </p>
          </div>

          <div>
            <h4 class="font-semibold text-zinc-900 dark:text-white mb-3">Tools & Features</h4>
            <ul class="space-y-2">
              <li><a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Gap Minimizer Engine</a></li>
              <li><a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Apple & Google Calendar Export</a></li>
              <li><a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Schedule PNG Generator</a></li>
              <li><a href="/" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Ivy League Preloaded Models</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-zinc-900 dark:text-white mb-3">Research & Articles</h4>
            <ul class="space-y-2">
              <li><a href="/blog/how-to-optimize-college-schedule" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Eliminating Awkward Campus Gaps</a></li>
              <li><a href="/blog/engineering-majors-guide-to-conflict-free-timetables" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Engineering Major's Timetable Guide</a></li>
              <li><a href="/blog" class="hover:text-zinc-900 dark:hover:text-white transition-colors">All Academic Planning Guides</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-semibold text-zinc-900 dark:text-white mb-3">Legal & Transparency</h4>
            <ul class="space-y-2">
              <li><a href="/privacy-policy" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Privacy Policy (GDPR/CCPA)</a></li>
              <li><a href="/terms-of-service" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Terms of Service</a></li>
              <li><a href="/about" class="hover:text-zinc-900 dark:hover:text-white transition-colors">About Our Mission</a></li>
              <li><a href="/contact" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Contact Support</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-8 border-t border-zinc-200/60 dark:border-zinc-800/60 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p>© {new Date().getFullYear()} Class Schedule Optimizer. Non-commercial open educational software. Client-side privacy-first architecture.</p>
          <div class="flex items-center gap-4 text-[11px] text-zinc-400">
            <span>Zero Server Tracking</span>
            <span>•</span>
            <span>Browser LocalStorage Protected</span>
            <span>•</span>
            <span>No Account Required</span>
          </div>
        </div>
      </div>
    </footer>

    <!-- Theme Toggle Handler -->
    <script is:inline>
      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.addEventListener('click', () => {
          const isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('theme', 'light');
          } else {
            document.documentElement.classList.add('dark');
            localStorage.setItem('theme', 'dark');
          }
        });
      }
    </script>
  </body>
</html>

