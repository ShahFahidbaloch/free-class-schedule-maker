---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  schemaJson?: object;
}

const {
  title,
  description,
  canonicalUrl = Astro.url.href,
  schemaJson
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Theme Detection -->
    <script is:inline>
      (function() {
        var savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch (e) {}
        if (savedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-[#fafafa] dark:bg-[#09090b] text-zinc-900 dark:text-zinc-100 antialiased selection:bg-zinc-900 selection:text-white dark:selection:bg-white dark:selection:text-zinc-950 transition-colors duration-150">
    <!-- LMS Academic Portal Top Bar -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-[#09090b]/80 border-b border-zinc-200/90 dark:border-zinc-800/90 transition-colors">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-6 h-12 flex items-center justify-between">
        <!-- Brand & Academic Mode Identifier -->
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-2 text-zinc-900 dark:text-white hover:opacity-90 transition">
            <span class="w-5 h-5 rounded bg-zinc-900 dark:bg-white text-white dark:text-zinc-950 flex items-center justify-center font-mono text-[10px] font-bold">
              //
            </span>
            <span class="font-mono text-xs font-bold tracking-tight">TIMETABLE // WORKBENCH</span>
          </a>
          <span class="text-zinc-300 dark:text-zinc-700">|</span>
          <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 hidden sm:inline">
            ACADEMIC YEAR 2026–2027
          </span>
        </div>

        <!-- Right Quick Tools & Theme Toggle -->
        <div class="flex items-center gap-3">
          <a 
            href="/blog" 
            class="text-xs font-mono text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white transition-colors hidden md:inline"
          >
            RESEARCH & DOCS
          </a>

          <!-- Theme Toggle -->
          <button 
            id="theme-toggle" 
            type="button"
            aria-label="Toggle theme"
            class="w-7 h-7 rounded-md border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 flex items-center justify-center text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition cursor-pointer"
          >
            <svg id="theme-sun" class="w-3.5 h-3.5 hidden dark:block text-zinc-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="theme-moon" class="w-3.5 h-3.5 block dark:hidden text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Workspace -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Theme Toggle Handler -->
    <script is:inline>
      (function() {
        var btn = document.getElementById('theme-toggle');
        if (btn) {
          btn.addEventListener('click', function() {
            var isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
              document.documentElement.classList.remove('dark');
              try { localStorage.setItem('theme', 'light'); } catch(e) {}
            } else {
              document.documentElement.classList.add('dark');
              try { localStorage.setItem('theme', 'dark'); } catch(e) {}
            }
          });
        }
      })();
    </script>
  </body>
</html>
