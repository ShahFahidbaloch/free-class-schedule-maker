---
import '../styles/global.css';
import { SUPPORTED_LANGUAGES } from '../data/i18nData';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonicalUrl?: string;
  ogImage?: string;
  schemaJson?: object;
  lang?: string;
  currentPath?: string;
}

const {
  title = "Class Schedule Maker — Free Weekly College & School Schedule Maker Online",
  description = "Design your ideal class schedule with our free weekly class schedule maker online. Effortlessly create conflict-free college, school, PCC, and UF class schedules with zero gaps. Export to iCal, Google Calendar, and printable PDF.",
  keywords = "class schedule, class schedule maker, free class schedule maker, weekly class schedule maker, class schedule maker template, pcc class schedule, college class schedule, uf class schedule, class schedule maker online, class schedule maker free, school schedule maker",
  canonicalUrl = Astro.url.href,
  ogImage = "https://classscheduleoptimizer.com/logo.png",
  schemaJson,
  lang = "en",
  currentPath = ""
} = Astro.props;

// Compute normalized path for hreflang links (e.g., "" for home, "/app" for app)
const rawPath = currentPath || Astro.url.pathname;
const normalizedPath = rawPath.replace(/^\/(es|tl|ja|fr|de|pt|ko|it)(\/|$)/, '$2') || '';
const cleanPath = normalizedPath.startsWith('/') ? normalizedPath : (normalizedPath ? `/${normalizedPath}` : '');

const siteName = "Class Schedule Maker";
const currentLangMeta = SUPPORTED_LANGUAGES.find(l => l.code === lang) || SUPPORTED_LANGUAGES[0];
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Alternates for Multilingual SEO -->
    <link rel="alternate" hreflang="x-default" href={`https://classscheduleoptimizer.com${cleanPath || '/'}`} />
    {SUPPORTED_LANGUAGES.map((locale) => (
      <link 
        rel="alternate" 
        hreflang={locale.code} 
        href={`https://classscheduleoptimizer.com${locale.code === 'en' ? (cleanPath || '/') : `/${locale.code}${cleanPath}`}`} 
      />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="Class Schedule Maker & Academic Timetable Planner" />
    <meta property="og:locale" content={currentLangMeta.ogLocale} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#09090b" />
    
    <!-- Theme Detection -->
    <script is:inline>
      (function() {
        var savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch (e) {}
        if (savedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-[#FBFBFD] dark:bg-[#09090b] text-zinc-900 dark:text-zinc-100 antialiased selection:bg-zinc-900 selection:text-white dark:selection:bg-white dark:selection:text-zinc-950 transition-colors duration-150">
    <!-- Navbar with Official Logo -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/85 dark:bg-[#09090b]/85 border-b border-zinc-200/90 dark:border-zinc-800/90 transition-colors">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
        
        <!-- Logo & Brand Name -->
        <a href="/" class="flex items-center gap-2.5 group">
          <img 
            src="/logo.svg" 
            alt="Class Schedule Logo" 
            class="w-7 h-7 rounded-lg group-hover:scale-105 transition-transform" 
          />
          <div class="flex flex-col">
            <span class="text-sm font-bold tracking-tight text-zinc-900 dark:text-white leading-none">
              Class Schedule
            </span>
            <span class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400 leading-tight">
              Timetable Optimizer
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-zinc-600 dark:text-zinc-400">
          <a href="/app" class="text-zinc-900 dark:text-white font-semibold hover:underline">Schedule Studio</a>
          <a href="/#dead-time" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Gap Optimization</a>
          <a href="/#course-planning" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Registration Strategy</a>
          <a href="/#templates-hub" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Templates Hub</a>
          <a href="/#portal-guides" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Portal Guides</a>
          <a href="/#faq" class="hover:text-zinc-900 dark:hover:text-white transition-colors">FAQ</a>
          <a href="/blog" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Articles</a>
        </nav>

        <!-- Right Actions -->
        <div class="flex items-center gap-2">
          <!-- Language Selector Dropdown -->
          <div class="relative">
            <details class="group relative">
              <summary class="list-none flex items-center gap-1.5 h-8.5 px-2.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-xs font-semibold text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-850 cursor-pointer select-none transition">
                <span>{currentLangMeta.flag}</span>
                <span class="hidden sm:inline text-[11px]">{currentLangMeta.nativeName}</span>
                <svg class="w-3 h-3 text-zinc-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="absolute right-0 mt-1 w-44 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] shadow-lg p-1.5 z-50 flex flex-col gap-0.5 text-xs">
                {SUPPORTED_LANGUAGES.map((item) => (
                  <a
                    href={`${item.code === 'en' ? (cleanPath || '/') : `/${item.code}${cleanPath}`}`}
                    class={`flex items-center justify-between px-2.5 py-1.5 rounded-lg transition-colors ${
                      item.code === lang 
                        ? 'bg-zinc-100 dark:bg-zinc-800 font-bold text-zinc-950 dark:text-white' 
                        : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-850 hover:text-zinc-950 dark:hover:text-white'
                    }`}
                  >
                    <span class="flex items-center gap-2">
                      <span>{item.flag}</span>
                      <span>{item.nativeName}</span>
                    </span>
                    {item.code === lang && <span class="text-[10px]">✓</span>}
                  </a>
                ))}
              </div>
            </details>
          </div>

          <!-- Launch Studio CTA -->
          <a
            href={lang === 'en' ? '/app' : `/${lang}/app`}
            class="h-8.5 px-3 rounded-lg bg-zinc-900 hover:bg-black text-white dark:bg-white dark:hover:bg-zinc-100 dark:text-zinc-950 text-xs font-semibold flex items-center gap-1.5 transition shadow-2xs"
          >
            <span>Launch Studio</span>
            <span class="text-[10px]">&rarr;</span>
          </a>

          <!-- Theme Toggle -->
          <button 
            id="theme-toggle" 
            type="button"
            aria-label="Toggle visual theme"
            class="w-8.5 h-8.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 flex items-center justify-center text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition cursor-pointer"
          >
            <svg id="theme-sun" class="w-4 h-4 hidden dark:block text-zinc-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="theme-moon" class="w-4 h-4 block dark:hidden text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Workspace -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Clean Footer -->
    <footer class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#09090b] text-xs text-zinc-500 dark:text-zinc-400 py-8 mt-12">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px]">
        <div class="flex flex-wrap items-center gap-3">
          <img src="/logo.svg" alt="Class Schedule" class="w-5 h-5 rounded" />
          <span class="font-bold text-zinc-900 dark:text-white">Class Schedule</span>
          <span>•</span>
          <a href="/app" class="hover:underline font-bold text-zinc-900 dark:text-white">Schedule Studio</a>
          <a href="/about" class="hover:underline">About</a>
          <a href="/contact" class="hover:underline">Contact</a>
          <a href="/privacy-policy" class="hover:underline">Privacy Policy</a>
          <a href="/terms-of-service" class="hover:underline">Terms of Service</a>
          <span>•</span>
          <a href="/app#feedback" class="hover:underline text-zinc-800 dark:text-zinc-200 font-semibold">Student Feedback</a>
        </div>
        <div class="flex items-center gap-3 text-zinc-400">
          <span>Client-Side Privacy Architecture</span>
          <span>•</span>
          <span>Zero Server Tracking</span>
        </div>
      </div>
    </footer>

    <!-- Theme Toggle Script -->
    <script is:inline>
      (function() {
        var btn = document.getElementById('theme-toggle');
        if (btn) {
          btn.addEventListener('click', function() {
            var isDark = document.documentElement.classList.contains('dark');
            if (isDark) {
              document.documentElement.classList.remove('dark');
              try { localStorage.setItem('theme', 'light'); } catch(e) {}
            } else {
              document.documentElement.classList.add('dark');
              try { localStorage.setItem('theme', 'dark'); } catch(e) {}
            }
          });
        }
      })();
    </script>
  </body>
</html>
