---
import '../styles/global.css';
import { SUPPORTED_LANGUAGES } from '../data/i18nData';
import AdPlacementPlaceholder from '../components/AdPlacementPlaceholder.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonicalUrl?: string;
  ogImage?: string;
  schemaJson?: object;
  lang?: string;
  currentPath?: string;
}

const {
  title = "Class Schedule Maker — Free Weekly College & School Schedule Maker Online",
  description = "Design your ideal class schedule with our free weekly class schedule maker online. Effortlessly create conflict-free college, school, PCC, and UF class schedules with zero gaps. Export to iCal, Google Calendar, and printable PDF.",
  keywords = "class schedule, class schedule maker, free class schedule maker, weekly class schedule maker, class schedule maker template, pcc class schedule, college class schedule, uf class schedule, class schedule maker online, class schedule maker free, school schedule maker",
  canonicalUrl = Astro.url.href,
  ogImage = "https://freeclassschedule.com/logo.png",
  schemaJson,
  lang = "en",
  currentPath = ""
} = Astro.props;

// Compute normalized path for hreflang links (e.g., "" for home, "/app" for app)
const rawPath = currentPath || Astro.url.pathname;
const normalizedPath = rawPath.replace(/^\/(es|tl|ja|fr|de|pt|ko|it)(\/|$)/, '$2') || '';
const cleanPath = normalizedPath.startsWith('/') ? normalizedPath : (normalizedPath ? `/${normalizedPath}` : '');

const isHomeRoute = cleanPath === '' || cleanPath === '/' || cleanPath === '/index';
const isAppRoute = cleanPath === '/app' || cleanPath === '/app/';
const isMultilingualRoute = isHomeRoute || isAppRoute;

const siteName = "Class Schedule Maker";
const currentLangMeta = SUPPORTED_LANGUAGES.find(l => l.code === lang) || SUPPORTED_LANGUAGES[0];
const langPrefix = lang === 'en' ? '' : `/${lang}`;
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Alternates for Multilingual SEO -->
    {isHomeRoute && (
      <>
        <link rel="alternate" hreflang="x-default" href="https://freeclassschedule.com/" />
        {SUPPORTED_LANGUAGES.map((locale) => (
          <link 
            rel="alternate" 
            hreflang={locale.code} 
            href={`https://freeclassschedule.com${locale.code === 'en' ? '/' : `/${locale.code}/`}`} 
          />
        ))}
      </>
    )}
    {isAppRoute && (
      <>
        <link rel="alternate" hreflang="x-default" href="https://freeclassschedule.com/app/" />
        {SUPPORTED_LANGUAGES.map((locale) => (
          <link 
            rel="alternate" 
            hreflang={locale.code} 
            href={`https://freeclassschedule.com${locale.code === 'en' ? '/app/' : `/${locale.code}/app/`}`} 
          />
        ))}
      </>
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="600" />
    <meta property="og:image:height" content="600" />
    <meta property="og:image:alt" content="Class Schedule Maker & Academic Timetable Planner" />
    <meta property="og:locale" content={currentLangMeta.ogLocale} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BWREB9S4SB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BWREB9S4SB');
    </script>

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#09090b" />
    
    <!-- Theme Detection -->
    <script is:inline>
      (function() {
        var savedTheme = null;
        try { savedTheme = localStorage.getItem('theme'); } catch (e) {}
        if (savedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>

    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-[#FBFBFD] dark:bg-[#09090b] text-zinc-900 dark:text-zinc-100 antialiased selection:bg-zinc-900 selection:text-white dark:selection:bg-white dark:selection:text-zinc-950 transition-colors duration-150">
    <!-- Navbar with Official Logo -->
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/85 dark:bg-[#09090b]/85 border-b border-zinc-200/90 dark:border-zinc-800/90 transition-colors">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-6 h-14 flex items-center justify-between">
        
        <!-- Logo & Brand Name -->
        <a href={lang === 'en' ? '/' : `/${lang}`} class="flex items-center gap-2.5 group shrink-0">
          <img 
            src="/logo.svg" 
            alt="Class Schedule Logo" 
            width="28"
            height="28"
            class="w-7 h-7 rounded-lg group-hover:scale-105 transition-transform" 
          />
          <div class="flex flex-col">
            <span class="text-sm font-bold tracking-tight text-zinc-900 dark:text-white leading-none">
              Class Schedule
            </span>
            <span class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400 leading-tight">
              Schedule Maker
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links (>= 1280px) -->
        <nav class="hidden xl:flex items-center gap-6 text-xs font-medium text-zinc-600 dark:text-zinc-400">
          <a href={`${langPrefix}/#dead-time`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Gap Optimization</a>
          <a href={`${langPrefix}/#course-planning`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Registration Strategy</a>
          <a href={`${langPrefix}/#templates-hub`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Templates Hub</a>
          <a href={`${langPrefix}/#portal-guides`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Portal Guides</a>
          <a href={`${langPrefix}/#faq`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">FAQ</a>
          <a href="/blog" class="hover:text-zinc-900 dark:hover:text-white transition-colors">Articles</a>
        </nav>

        <!-- Right Actions: Responsive for Mobile, Tablet, Laptop, and Desktop -->
        <div class="flex items-center gap-2 shrink-0">
          <!-- Language Selector Dropdown -->
          <div class="relative">
            <details class="group relative">
              <summary class="list-none flex items-center gap-1.5 h-8.5 px-2.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-xs font-semibold text-zinc-700 dark:text-zinc-300 hover:bg-zinc-50 dark:hover:bg-zinc-850 cursor-pointer select-none transition">
                <span>{currentLangMeta.flag}</span>
                <span class="hidden sm:inline text-[11px] font-mono uppercase">{currentLangMeta.code}</span>
                <svg class="w-3 h-3 text-zinc-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="absolute right-0 mt-1 w-44 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] shadow-lg p-1.5 z-50 flex flex-col gap-0.5 text-xs">
                {SUPPORTED_LANGUAGES.map((item) => (
                  <a
                    href={`${item.code === 'en' ? (cleanPath || '/') : `/${item.code}${cleanPath}`}`}
                    onclick={`try { localStorage.setItem('preferred_lang', '${item.code}'); window.dispatchEvent(new CustomEvent('langchange', { detail: '${item.code}' })); } catch(e){}`}
                    class={`flex items-center justify-between px-2.5 py-1.5 rounded-lg transition-colors ${
                      item.code === lang 
                        ? 'bg-zinc-100 dark:bg-zinc-800 font-bold text-zinc-950 dark:text-white' 
                        : 'text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-850 hover:text-zinc-950 dark:hover:text-white'
                    }`}
                  >
                    <span class="flex items-center gap-2">
                      <span>{item.flag}</span>
                      <span>{item.nativeName}</span>
                    </span>
                    {item.code === lang && <span class="text-[10px]">✓</span>}
                  </a>
                ))}
              </div>
            </details>
          </div>

          <!-- Launch Studio CTA -->
          <a
            href={lang === 'en' ? '/app' : `/${lang}/app`}
            class="h-8.5 px-3 rounded-lg bg-zinc-900 hover:bg-black text-white dark:bg-white dark:hover:bg-zinc-100 dark:text-zinc-950 text-xs font-semibold flex items-center gap-1.5 transition shadow-2xs"
          >
            <span class="hidden sm:inline">Launch Studio</span>
            <span class="sm:hidden">Studio</span>
            <span class="text-[10px]">&rarr;</span>
          </a>

          <!-- Theme Toggle -->
          <button 
            id="theme-toggle" 
            type="button"
            aria-label="Toggle visual theme"
            class="w-8.5 h-8.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hidden sm:flex items-center justify-center text-zinc-600 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition cursor-pointer"
          >
            <svg id="theme-sun" class="w-4 h-4 hidden dark:block text-zinc-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="theme-moon" class="w-4 h-4 block dark:hidden text-zinc-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <!-- Navigation Hamburger Button (Tablets & Mobile < 1280px) -->
          <button
            id="mobile-menu-open-btn"
            type="button"
            aria-label="Open Navigation Menu"
            class="w-8.5 h-8.5 xl:hidden rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 flex items-center justify-center text-zinc-800 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition cursor-pointer select-none"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

      </div>
    </header>

    <!-- Navigation Drawer Overlay & Sheet (< 1280px) -->
    <div
      id="mobile-drawer-backdrop"
      class="fixed inset-0 z-50 bg-black/60 backdrop-blur-xs transition-opacity duration-200 opacity-0 pointer-events-none xl:hidden"
    >
      <div
        id="mobile-drawer-sheet"
        class="fixed inset-y-0 right-0 w-[85%] max-w-sm bg-white dark:bg-[#121215] border-l border-zinc-200 dark:border-zinc-800 p-6 flex flex-col justify-between shadow-2xl transition-transform duration-200 translate-x-full overflow-y-auto"
      >
        <div class="space-y-6">
          <!-- Drawer Header -->
          <div class="flex items-center justify-between pb-4 border-b border-zinc-100 dark:border-zinc-800">
            <div class="flex items-center gap-2.5">
              <img src="/logo.svg" alt="Logo" width="28" height="28" class="w-7 h-7 rounded-lg" />
              <div class="flex flex-col">
                <span class="text-sm font-bold text-zinc-900 dark:text-white">Class Schedule</span>
                <span class="text-[10px] font-mono text-zinc-500">Schedule Maker</span>
              </div>
            </div>
            <button
              id="mobile-drawer-close-btn"
              type="button"
              aria-label="Close menu"
              class="w-11 h-11 rounded-xl border border-zinc-200 dark:border-zinc-800 flex items-center justify-center text-zinc-500 hover:text-zinc-950 dark:hover:text-white cursor-pointer"
            >
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <!-- Drawer Primary CTA -->
          <a
            href={lang === 'en' ? '/app' : `/${lang}/app`}
            class="w-full h-12 px-4 rounded-xl bg-zinc-950 hover:bg-black text-white dark:bg-white dark:hover:bg-zinc-100 dark:text-zinc-950 text-sm font-bold flex items-center justify-center gap-2 shadow-sm transition active:scale-[0.98]"
          >
            <span>Launch Schedule Studio</span>
            <span>&rarr;</span>
          </a>

          <!-- Page Links -->
          <nav class="flex flex-col space-y-1">
            <a href={lang === 'en' ? '/app' : `/${lang}/app`} class="mobile-nav-link flex items-center justify-between py-2.5 px-3 rounded-lg text-sm font-semibold text-zinc-900 dark:text-white hover:bg-zinc-100 dark:hover:bg-zinc-855">
              <span>Schedule Studio</span>
              <span class="text-xs text-zinc-400">&rarr;</span>
            </a>
            <a href={`${langPrefix}/#dead-time`} class="mobile-nav-link flex items-center justify-between py-2.5 px-3 rounded-lg text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-850">
              <span>Gap Optimization</span>
            </a>
            <a href={`${langPrefix}/#course-planning`} class="mobile-nav-link flex items-center justify-between py-2.5 px-3 rounded-lg text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-850">
              <span>Registration Strategy</span>
            </a>
            <a href={`${langPrefix}/#templates-hub`} class="mobile-nav-link flex items-center justify-between py-2.5 px-3 rounded-lg text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-850">
              <span>Templates Hub</span>
            </a>
            <a href={`${langPrefix}/#portal-guides`} class="mobile-nav-link flex items-center justify-between py-2.5 px-3 rounded-lg text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-850">
              <span>Portal Guides</span>
            </a>
            <a href={`${langPrefix}/#faq`} class="mobile-nav-link flex items-center justify-between py-2.5 px-3 rounded-lg text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-850">
              <span>FAQ</span>
            </a>
            <a href="/blog" class="mobile-nav-link flex items-center justify-between py-2.5 px-3 rounded-lg text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-850">
              <span>Articles</span>
            </a>
          </nav>

          <!-- Drawer Language Selector -->
          <div class="pt-3 border-t border-zinc-100 dark:border-zinc-800 space-y-2">
            <span class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-400">Language</span>
            <div class="grid grid-cols-2 gap-1.5 text-xs">
              {SUPPORTED_LANGUAGES.map((item) => (
                <a
                  href={`${item.code === 'en' ? (cleanPath || '/') : `/${item.code}${cleanPath}`}`}
                  onclick={`try { localStorage.setItem('preferred_lang', '${item.code}'); window.dispatchEvent(new CustomEvent('langchange', { detail: '${item.code}' })); } catch(e){}`}
                  class={`flex items-center gap-2 p-2.5 rounded-lg border transition ${
                    item.code === lang 
                      ? 'border-zinc-900 bg-zinc-100 dark:border-white dark:bg-zinc-800 font-bold text-zinc-950 dark:text-white' 
                      : 'border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-850'
                  }`}
                >
                  <span>{item.flag}</span>
                  <span class="truncate">{item.nativeName}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Drawer Bottom: Theme Toggle & Info -->
        <div class="pt-6 border-t border-zinc-100 dark:border-zinc-800 flex items-center justify-between">
          <span class="text-xs font-medium text-zinc-500">Theme</span>
          <button 
            id="mobile-theme-toggle" 
            type="button"
            class="h-10 px-3.5 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 flex items-center gap-2 text-xs font-semibold text-zinc-800 dark:text-zinc-200 cursor-pointer"
          >
            <span class="dark:hidden">☀️ Light Mode</span>
            <span class="hidden dark:inline">🌙 Dark Mode</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Main Content Workspace -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Clean Footer -->
    <footer class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#09090b] text-xs text-zinc-500 dark:text-zinc-400 py-8 mt-12">
      <div class="max-w-[1536px] mx-auto px-4 sm:px-6 mb-6">
        <!-- Disabled AdSense Placement Area (Footer) -->
        <AdPlacementPlaceholder slotId="layout-footer" />
      </div>
      <div class="max-w-[1536px] mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px]">
        <div class="flex flex-wrap items-center gap-3">
          <img src="/logo.svg" alt="Class Schedule" class="w-5 h-5 rounded" />
          <span class="font-bold text-zinc-900 dark:text-white">Class Schedule</span>
          <span>•</span>
          <a href="/app" class="hover:underline font-bold text-zinc-900 dark:text-white">Schedule Studio</a>
          <a href="/about" class="hover:underline">About</a>
          <a href="/contact" class="hover:underline">Contact</a>
          <a href="/privacy-policy" class="hover:underline">Privacy Policy</a>
          <a href="/terms-of-service" class="hover:underline">Terms of Service</a>
          <span>•</span>
          <a href="/app#feedback" class="hover:underline text-zinc-800 dark:text-zinc-200 font-semibold">Student Feedback</a>
        </div>
        <div class="flex items-center gap-3 text-zinc-400">
          <span>Client-Side Privacy Architecture</span>
          <span>•</span>
          <span>Zero Server Tracking</span>
        </div>
      </div>
    </footer>

    <!-- Theme Toggle & Mobile Drawer Scripts -->
    <script is:inline>
      (function() {
        // Theme Toggles (Desktop & Mobile)
        function toggleTheme() {
          var isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            document.documentElement.classList.remove('dark');
            try { localStorage.setItem('theme', 'light'); } catch(e) {}
          } else {
            document.documentElement.classList.add('dark');
            try { localStorage.setItem('theme', 'dark'); } catch(e) {}
          }
        }

        var btn = document.getElementById('theme-toggle');
        if (btn) btn.addEventListener('click', toggleTheme);

        var mobThemeBtn = document.getElementById('mobile-theme-toggle');
        if (mobThemeBtn) mobThemeBtn.addEventListener('click', toggleTheme);

        // Mobile Drawer Controller
        var openBtn = document.getElementById('mobile-menu-open-btn');
        var closeBtn = document.getElementById('mobile-drawer-close-btn');
        var backdrop = document.getElementById('mobile-drawer-backdrop');
        var sheet = document.getElementById('mobile-drawer-sheet');

        function openDrawer() {
          if (!backdrop || !sheet) return;
          backdrop.classList.remove('opacity-0', 'pointer-events-none');
          backdrop.classList.add('opacity-100');
          sheet.classList.remove('translate-x-full');
          sheet.classList.add('translate-x-0');
          document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
          if (!backdrop || !sheet) return;
          backdrop.classList.remove('opacity-100');
          backdrop.classList.add('opacity-0', 'pointer-events-none');
          sheet.classList.remove('translate-x-0');
          sheet.classList.add('translate-x-full');
          document.body.style.overflow = '';
        }

        if (openBtn) openBtn.addEventListener('click', openDrawer);
        if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
        if (backdrop) {
          backdrop.addEventListener('click', function(e) {
            if (e.target === backdrop) closeDrawer();
          });
        }

        // Close on link click inside drawer
        document.querySelectorAll('.mobile-nav-link').forEach(function(link) {
          link.addEventListener('click', closeDrawer);
        });

        // Global smooth scroll handler for hash anchor links across all viewports
        document.querySelectorAll('a[href*="#"]').forEach(function(link) {
          link.addEventListener('click', function(e) {
            var href = link.getAttribute('href');
            if (!href) return;
            var hashIdx = href.indexOf('#');
            if (hashIdx === -1) return;
            var targetId = href.substring(hashIdx + 1);
            if (!targetId) return;
            var targetEl = document.getElementById(targetId);
            if (targetEl) {
              var currPath = window.location.pathname.replace(/\/$/, '') || '/';
              var linkPath = href.substring(0, hashIdx).replace(/\/$/, '') || '/';
              if (currPath === linkPath || href.startsWith('#')) {
                e.preventDefault();
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                try { history.pushState(null, '', '#' + targetId); } catch(err) {}
                closeDrawer();
              }
            }
          });
        });
      })();
    </script>
  </body>
</html>
