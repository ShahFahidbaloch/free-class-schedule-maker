---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AdPlacementPlaceholder from '../../components/AdPlacementPlaceholder.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const datePublishedIso = post.data.publishDate.toISOString();
const dateModifiedIso = (post.data.updatedDate || post.data.publishDate).toISOString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "image": "https://freeclassschedule.com/logo.png",
  "datePublished": datePublishedIso,
  "dateModified": dateModifiedIso,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": Astro.url.href
  },
  "author": {
    "@type": "Organization",
    "name": post.data.author,
    "url": "https://freeclassschedule.com/about/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Class Schedule Maker",
    "logo": {
      "@type": "ImageObject",
      "url": "https://freeclassschedule.com/logo.png"
    }
  }
};
---

<Layout 
  title={`${post.data.title} — Free Class Schedule Maker`}
  description={post.data.description}
  schemaJson={articleSchema}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-zinc-500 mb-6">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <a href="/blog" class="hover:underline">Guides</a>
      <span>/</span>
      <span class="text-zinc-800 dark:text-zinc-200 truncate">{post.data.title}</span>
    </nav>

    <!-- Header Meta -->
    <header class="space-y-4 pb-8 border-b border-zinc-200/80 dark:border-zinc-800/80 mb-10">
      <div class="flex flex-wrap items-center gap-3 text-xs text-zinc-500">
        <span class="px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium">
          {post.data.category}
        </span>
        <span>•</span>
        <span>{post.data.readTime}</span>
        <span>•</span>
        <span>
          Published: <time datetime={datePublishedIso}>{post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
        </span>
        {post.data.updatedDate && (
          <>
            <span>•</span>
            <span>
              Updated: <time datetime={dateModifiedIso}>{post.data.updatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
            </span>
          </>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-white leading-[1.15]">
        {post.data.title}
      </h1>

      <p class="text-base text-zinc-600 dark:text-zinc-400">
        {post.data.description}
      </p>

      <div class="pt-2 flex items-center gap-3 text-xs text-zinc-500">
        <span>By <strong class="text-zinc-800 dark:text-zinc-200">{post.data.author}</strong></span>
        <span>•</span>
        <a href="/about" class="hover:underline text-zinc-600 dark:text-zinc-400">Editorial Team</a>
      </div>
    </header>

    <!-- Post Body -->
    <div class="prose prose-zinc dark:prose-invert max-w-none text-sm sm:text-base leading-relaxed space-y-6 [&_h1]:hidden [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-2 [&_p]:text-zinc-700 dark:[&_p]:text-zinc-300 [&_strong]:text-zinc-950 dark:[&_strong]:text-white [&_blockquote]:border-l-4 [&_blockquote]:border-zinc-900 dark:[&_blockquote]:border-zinc-100 [&_blockquote]:pl-4 [&_blockquote]:py-1 [&_blockquote]:my-5 [&_blockquote]:text-zinc-800 dark:[&_blockquote]:text-zinc-200 [&_blockquote]:bg-zinc-50 dark:[&_blockquote]:bg-zinc-900/50 [&_blockquote]:rounded-r-xl [&_pre]:bg-zinc-100 dark:[&_pre]:bg-zinc-900 [&_pre]:text-zinc-900 dark:[&_pre]:text-zinc-100 [&_pre]:p-4 [&_pre]:rounded-xl [&_pre]:text-xs [&_pre]:overflow-x-auto [&_pre_code]:text-zinc-900 dark:[&_pre_code]:text-zinc-100 [&_code]:text-zinc-900 dark:[&_code]:text-zinc-100 [&_table]:w-full [&_table]:my-6 [&_table]:border-collapse [&_th]:border-b [&_th]:border-zinc-200 dark:[&_th]:border-zinc-800 [&_th]:p-3 [&_th]:text-left [&_th]:text-xs [&_th]:font-bold [&_th]:text-zinc-900 dark:[&_th]:text-white [&_td]:border-b [&_td]:border-zinc-100 dark:[&_td]:border-zinc-800/60 [&_td]:p-3 [&_td]:text-xs sm:[&_td]:text-sm">
      <Content />
    </div>

    <!-- Disabled AdSense Placement Area (Post Bottom) -->
    <AdPlacementPlaceholder slotId="blog-post-bottom" />

    <!-- Back to tool banner -->
    <div class="mt-16 p-6 rounded-2xl bg-zinc-100 dark:bg-[#121215] border border-zinc-200/80 dark:border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="text-sm font-bold text-zinc-950 dark:text-white">Ready to optimize your semester schedule?</h4>
        <p class="text-xs text-zinc-500">Test combinations, eliminate gaps, and export to iCal in minutes.</p>
      </div>
      <a 
        href="/"
        class="px-4 py-2 rounded-xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 font-semibold text-xs hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-colors whitespace-nowrap shadow-xs"
      >
        Open Schedule Optimizer
      </a>
    </div>
  </article>
</Layout>

