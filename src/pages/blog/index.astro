---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<Layout 
  title="Academic Scheduling Science & Guides — Class Schedule Optimizer"
  description="In-depth educational guides on college schedule optimization, eliminating dead gaps, managing engineering workloads, and semester planning."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg text-xs font-medium bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs">
        <span>Curriculum Science & Guides</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-white">
        Academic Productivity & Schedule Optimization
      </h1>
      <p class="text-base text-zinc-600 dark:text-zinc-400">
        Peer-reviewed cognitive science, algorithmic scheduling methodologies, and tactical strategies to maximize collegiate GPA and eliminate wasted hours.
      </p>
    </div>

    <!-- Article Cards List -->
    <div class="space-y-6">
      {sortedPosts.map(post => (
        <a 
          href={`/blog/${post.id}`}
          class="block p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#121215] border border-zinc-200/80 dark:border-zinc-800/80 hover:border-zinc-400 dark:hover:border-zinc-600 transition-all group shadow-xs"
        >
          <div class="flex items-center gap-3 text-xs text-zinc-500 mb-2">
            <span class="px-2 py-0.5 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium">
              {post.data.category}
            </span>
            <span>•</span>
            <span>{post.data.readTime}</span>
            <span>•</span>
            <time datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
          </div>

          <h2 class="text-xl sm:text-2xl font-bold text-zinc-950 dark:text-white group-hover:text-zinc-700 dark:group-hover:text-zinc-200 transition-colors mb-3">
            {post.data.title}
          </h2>

          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
            {post.data.description}
          </p>

          <div class="flex items-center gap-2 text-xs font-semibold text-zinc-900 dark:text-white group-hover:translate-x-1 transition-transform">
            <span>Read Complete Field Guide</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

