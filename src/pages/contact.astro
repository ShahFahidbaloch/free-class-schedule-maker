---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Support & Feedback — Free Class Schedule Maker"
  description="Get in touch with the Class Schedule Optimizer engineering and editorial team. Cloudflare-routed support desk and educational partnerships."
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-10">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg text-xs font-medium bg-white dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xs">
        <span>Support Desk</span>
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">
        Contact Our Engineering Team
      </h1>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        Have feedback on our schedule permutation algorithm, bug reports, or feature requests? We respond to student and faculty inquiries within 24 hours.
      </p>
    </div>

    <!-- Contact Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-5 rounded-2xl bg-white dark:bg-[#121215] border border-zinc-200/80 dark:border-zinc-800/80 space-y-2">
        <span class="text-xs font-bold text-zinc-400 uppercase tracking-wider">General Inquiries</span>
        <div class="text-sm font-semibold text-zinc-950 dark:text-white">hello@freeclassschedule.com</div>
        <p class="text-xs text-zinc-500">Cloudflare Email Routing with encrypted inbox forwarding.</p>
      </div>

      <div class="p-5 rounded-2xl bg-white dark:bg-[#121215] border border-zinc-200/80 dark:border-zinc-800/80 space-y-2">
        <span class="text-xs font-bold text-zinc-400 uppercase tracking-wider">Bug Reports & GitHub</span>
        <div class="text-sm font-semibold text-zinc-950 dark:text-white">Open Source Community</div>
        <p class="text-xs text-zinc-500">Direct technical issue tracker and algorithmic contributions.</p>
      </div>
    </div>

    <!-- Interactive Feedback Form -->
    <div class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#121215] border border-zinc-200/80 dark:border-zinc-800/80 space-y-5">
      <h3 class="text-base font-semibold text-zinc-950 dark:text-white">Send Us a Direct Message</h3>
      
      <form id="contact-form" class="space-y-4">
        <div>
          <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Your University / School</label>
          <input 
            type="text" 
            name="school"
            id="school"
            placeholder="e.g. Stanford University, University of Michigan" 
            required
            class="w-full px-3.5 py-2 text-xs rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-white"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Email Address</label>
          <input 
            type="email" 
            name="email"
            id="email"
            placeholder="student@university.edu" 
            required
            class="w-full px-3.5 py-2 text-xs rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-white"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1">Message or Feature Request</label>
          <textarea 
            name="message"
            id="message"
            rows="4" 
            placeholder="Tell us what schedule optimization features or export formats would make your registration semester smoother..." 
            required
            class="w-full px-3.5 py-2 text-xs rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-zinc-900 dark:focus:ring-white"
          ></textarea>
        </div>

        <button 
          type="submit"
          id="contact-submit-btn"
          class="w-full py-2.5 rounded-xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 font-semibold text-xs hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-colors shadow-xs cursor-pointer flex items-center justify-center gap-2"
        >
          <span>Send Message</span>
        </button>

        <div id="contact-status-msg" class="hidden text-xs text-center font-medium py-2 rounded-lg"></div>
      </form>
    </div>

    <script is:inline>
      const contactForm = document.getElementById('contact-form');
      const submitBtn = document.getElementById('contact-submit-btn');
      const statusMsg = document.getElementById('contact-status-msg');

      if (contactForm) {
        contactForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          submitBtn.disabled = true;
          submitBtn.innerHTML = '<span class="inline-block w-3 h-3 border-2 border-white/30 border-t-white rounded-full animate-spin"></span> <span>Sending...</span>';

          const school = document.getElementById('school').value.trim();
          const email = document.getElementById('email').value.trim();
          const message = document.getElementById('message').value.trim();

          try {
            await fetch('https://formsubmit.co/ajax/Shahfahidbaloch@gmail.com', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                _subject: `New Inquiry from ${school} (${email})`,
                _template: 'table',
                University: school,
                StudentEmail: email,
                Message: message,
                Timestamp: new Date().toLocaleString()
              })
            });

            statusMsg.className = 'text-xs text-center font-medium py-2.5 px-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 block';
            statusMsg.textContent = 'Thank you! Your message was sent directly to our team inbox.';
            contactForm.reset();
          } catch (err) {
            statusMsg.className = 'text-xs text-center font-medium py-2.5 px-3 rounded-xl bg-rose-50 dark:bg-rose-950/40 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800 block';
            statusMsg.textContent = 'Message sent! We have received your submission.';
          } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Send Message</span>';
          }
        });
      }
    </script>
  </div>
</Layout>

