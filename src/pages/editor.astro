---
import '../styles/global.css';
import AcademicStudioApp from '../components/AcademicStudioApp';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <title>Schedule Studio — Class Schedule Maker</title>
    <link rel="canonical" href="https://yourdomain.com/app" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta http-equiv="refresh" content="0; url=/app" />
    <script is:inline>
      window.location.replace("/app");
    </script>
  </head>
  <body class="min-h-screen bg-[#FBFBFD] dark:bg-[#09090b] text-zinc-900 dark:text-zinc-100">
    <AcademicStudioApp client:load />
  </body>
</html>
