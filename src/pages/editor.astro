---
import '../styles/global.css';
import AcademicStudioApp from '../components/AcademicStudioApp';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/app" />
    <title>Redirecting to Schedule Studio...</title>
    <link rel="canonical" href="https://freeclassschedule.com/app" />
    <meta name="robots" content="noindex, follow" />
    <script is:inline>
      window.location.replace('/app');
    </script>
  </head>
  <body class="bg-[#FBFBFD] dark:bg-[#09090b] text-zinc-900 dark:text-zinc-100 flex items-center justify-center min-h-screen font-sans">
    <p class="text-sm">Redirecting to <a href="/app" class="underline font-bold">Schedule Studio (/app)</a>...</p>
  </body>
</html>
