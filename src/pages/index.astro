---
import Layout from '../layouts/Layout.astro';
import { 
  Sparkles, 
  ArrowRight, 
  Clock, 
  Calendar, 
  BookOpen, 
  ShieldCheck, 
  Download, 
  FileSpreadsheet, 
  FileText, 
  Layers, 
  CheckCircle2,
  CalendarDays
} from 'lucide-react';

const faqList = [
  {
    q: "How does the Gap Optimizer algorithm eliminate awkward campus gaps?",
    a: "The engine solves an interval scheduling combinatorial optimization problem across every alternative course section you input. It converts all lecture start and end times into discrete integer minutes from midnight, discards any combinations with conflicting intervals, and evaluates the remaining permutations to select the schedule with minimal idle waiting time between lectures."
  },
  {
    q: "Why are 1-to-2 hour campus gaps damaging to academic performance?",
    a: "Organizational psychology and cognitive science research on attention residue (notably by Dr. Sophie Leroy) proves that transitioning between different cognitive contexts imposes a 20 to 30-minute refocus penalty. Considering campus transit, finding study space, and packing up early, a 75-minute gap leaves less than 20 minutes of shallow focus. This fragmented dead time creates fatigue without producing real study output."
  },
  {
    q: "Can I export my timetable directly to Apple Calendar, Google Calendar, and Microsoft Outlook?",
    a: "Yes. In the Schedule Studio (/editor), clicking 'Export .ICS' generates a standard RFC 5545 iCalendar file configured with 16 recurring weekly events for your full semester, equipped with 15-minute advance alerts. You can open it natively on iPhone, Mac, Android, Google Calendar, and Outlook."
  },
  {
    q: "Is any student or university course registration data stored on external servers?",
    a: "No. The entire platform operates with zero backend telemetry and strict client-side privacy architecture. All timetable calculations, conflict detection, and course inputs are processed purely within your browser and saved exclusively in local storage."
  },
  {
    q: "What is the optimal credit hour distribution between MWF and Tuesday/Thursday?",
    a: "For a standard 15-credit semester, we recommend an 8/7 or 9/6 balance: three 3-credit modules on Monday/Wednesday/Friday (50-minute lectures) and two 3-credit modules on Tuesday/Thursday (75-minute lectures). This prevents mid-week exam crunches and preserves Friday afternoons for project work."
  },
  {
    q: "How should STEM majors schedule 3-hour laboratory blocks?",
    a: "Always anchor fixed 3-hour wet or hardware laboratory blocks first, ideally on Tuesday or Thursday afternoons. Because laboratory capacities are capped by physical bench equipment, their times cannot be shifted. Once anchored, arrange high-capacity lecture modules around them with at least a 30-minute cognitive buffer."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
  title="The Smart Class Schedule Maker — Build Conflict-Free Timetables"
  description="Build conflict-free weekly timetables in seconds. Eliminate awkward campus gaps and export to Apple Calendar, Google Calendar, and PDF."
  schemaJson={faqSchema}
>
  <!-- Minimal Hero Section -->
  <section class="max-w-[1280px] mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-14 text-center space-y-6">
    
    <!-- Micro Badge -->
    <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-xs font-mono font-medium text-zinc-600 dark:text-zinc-400 shadow-2xs">
      <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-white"></span>
      <span>Timetable Studio &bull; Open Academic Tool</span>
    </div>

    <!-- Punchy Single H1 -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold tracking-tight text-zinc-950 dark:text-white max-w-4xl mx-auto leading-[1.08]">
      The Smart Class Schedule Maker.
    </h1>

    <!-- One Line Subheadline -->
    <p class="text-base sm:text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto font-normal">
      Build conflict-free weekly timetables in seconds.
    </p>

    <!-- Primary Call To Action (Hero Center) -->
    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3">
      <a
        href="/editor"
        class="group relative inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-zinc-950 hover:bg-black text-white dark:bg-white dark:hover:bg-zinc-100 dark:text-zinc-950 text-sm sm:text-base font-bold shadow-md hover:shadow-xl transition-all duration-200 active:scale-[0.98]"
      >
        <span>Launch Schedule Studio</span>
        <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

    <!-- Minimal Aesthetic Preview Mockup Card -->
    <div class="pt-10 max-w-3xl mx-auto">
      <div class="p-4 sm:p-6 rounded-3xl border border-zinc-200/90 dark:border-zinc-800 bg-white/70 dark:bg-[#121215]/70 backdrop-blur-md shadow-lg space-y-4 text-left">
        <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
            <span class="text-xs font-mono font-semibold text-zinc-400 ml-2">STUDIO PREVIEW &bull; 08:00 AM – 08:00 PM</span>
          </div>
          <span class="text-xs font-mono font-bold text-zinc-500">15 Credits &bull; 0 Conflicts</span>
        </div>

        <div class="grid grid-cols-5 gap-2 text-center text-xs font-bold py-1 text-zinc-500">
          <div>Mon</div>
          <div>Tue</div>
          <div>Wed</div>
          <div>Thu</div>
          <div>Fri</div>
        </div>

        <div class="grid grid-cols-5 gap-2 h-28">
          <div class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex flex-col justify-between">
            <span class="font-bold text-xs text-zinc-900 dark:text-white">CS 101</span>
            <span class="text-[10px] font-mono text-zinc-500">10:00 - 11:15 AM</span>
          </div>
          <div class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex flex-col justify-between">
            <span class="font-bold text-xs text-zinc-900 dark:text-white">ENG 102</span>
            <span class="text-[10px] font-mono text-zinc-500">11:00 - 12:15 PM</span>
          </div>
          <div class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex flex-col justify-between">
            <span class="font-bold text-xs text-zinc-900 dark:text-white">CS 101</span>
            <span class="text-[10px] font-mono text-zinc-500">10:00 - 11:15 AM</span>
          </div>
          <div class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex flex-col justify-between">
            <span class="font-bold text-xs text-zinc-900 dark:text-white">ENG 102</span>
            <span class="text-[10px] font-mono text-zinc-500">11:00 - 12:15 PM</span>
          </div>
          <div class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex flex-col justify-between">
            <span class="font-bold text-xs text-zinc-900 dark:text-white">CS 101</span>
            <span class="text-[10px] font-mono text-zinc-500">10:00 - 11:15 AM</span>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- High-Value Editorial Hub (1,500+ words for Google AdSense) -->
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 py-12 space-y-16">
    
    <!-- Bento Grid Section 1: The Science of Gap Minimization in University Timetables -->
    <section id="science-of-gaps" class="scroll-mt-20">
      <div class="p-8 sm:p-12 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] shadow-xs space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-bold tracking-wider text-zinc-500 uppercase">
            ALGORITHM SPECIFICATION &bull; INTERVAL SCHEDULING
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
            The Science of Gap Minimization in University Timetables
          </h2>
        </div>

        <div class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed space-y-4">
          <p>
            University course registration presents a classic discrete combinatorial optimization challenge. When an undergraduate student enrolls in four to six modules—each offering multiple alternative lecture sessions, discussion sections, and laboratory blocks—the total number of possible combinations compounds factorially. For five courses with three alternative times each, students navigate 243 discrete candidate timetables.
          </p>

          <p>
            The fundamental flaw in manual timetable assembly is the accidental introduction of <strong>fragmented campus voids</strong>. A 60-to-90 minute interval between lectures is too brief to walk back to off-campus housing or engage in deep analytical work, yet long enough to cause decision fatigue and mental drift.
          </p>

          <!-- Bento Sub-Cards -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-900/40 space-y-2">
              <span class="font-bold text-xs uppercase font-mono text-zinc-900 dark:text-white">
                ATTENTION RESIDUE & COGNITIVE PENALTY
              </span>
              <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">
                Peer-reviewed research on attention residue demonstrates that context-switching between complex academic disciplines incurs a 20 to 30-minute cognitive adjustment period. An isolated 75-minute gap yields under 25 minutes of usable shallow focus once packing, walking, and setting up are factored in.
              </p>
            </div>

            <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-900/40 space-y-2">
              <span class="font-bold text-xs uppercase font-mono text-zinc-900 dark:text-white">
                CONSOLIDATED BLOCK EFFICIENCY
              </span>
              <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">
                Consolidating lectures into consecutive morning blocks (with 15-minute passing walks) preserves large, uninterrupted 4-hour afternoon blocks. These consolidated blocks provide the uninterrupted cognitive flow necessary for STEM problem sets, programming labs, and analytical writing.
              </p>
            </div>
          </div>

          <p>
            Our engine addresses this problem via a two-stage deterministic resolution:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-xs sm:text-sm">
            <li>
              <strong>Stage 1 (Overlap Pruning):</strong> Maps all class time intervals into integer minutes from midnight. For any candidate section pair on the same day with intervals [s₁, e₁] and [s₂, e₂], the algorithm verifies that max(s₁, s₂) &ge; min(e₁, e₂). Overlapping combinations are immediately eliminated.
            </li>
            <li>
              <strong>Stage 2 (Idle Gap Minimization):</strong> For all valid, conflict-free permutations, the solver computes the total weekly dead time and identifies the configuration that maximizes consolidated focus blocks.
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Bento Grid Section 2: Step-by-Step College Course Planning Strategy -->
    <section id="course-planning" class="scroll-mt-20">
      <div class="p-8 sm:p-12 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] shadow-xs space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-bold tracking-wider text-zinc-500 uppercase">
            ACADEMIC ADVISING &bull; 15-CREDIT CURRICULUM
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
            Step-by-Step College Course Planning Strategy
          </h2>
        </div>

        <div class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed space-y-4">
          <p>
            Graduating within four academic years requires completing 120 semester credit hours—an average of 15 credits per term across eight terms. However, treating every credit as equivalent in effort leads directly to mid-term exam clustering, deadline overlap, and GPA decline.
          </p>

          <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-900/40 space-y-3">
            <h3 class="text-sm font-bold text-zinc-900 dark:text-white">The 2:2:1 Workload Balancing Formula</h3>
            <ul class="list-disc pl-5 space-y-1.5 text-xs sm:text-sm">
              <li>
                <strong>Two Quantitative Heavyweights (6–8 Credits):</strong> Rigorous major requirements (e.g. Data Structures, Multivariable Calculus, Organic Chemistry) that demand weekly calculation sets.
              </li>
              <li>
                <strong>Two Qualitative Seminars (6 Credits):</strong> Writing-intensive breadth electives or general education requirements evaluated through mid-term essays.
              </li>
              <li>
                <strong>One Applied Practical / Studio Block (1–3 Credits):</strong> Hardware engineering laboratory, visual design studio, or physical activity requiring sensory immersion rather than rote memorization.
              </li>
            </ul>
          </div>

          <h3 class="text-base font-bold text-zinc-900 dark:text-white pt-2">Managing Multi-Hour Laboratory Blocks</h3>
          <p>
            Laboratory sections require physical equipment benches, capping seat capacity to 18–24 students. Because laboratory timings cannot be adjusted, always anchor them on Tuesday or Thursday afternoons first. Once anchored, permute your large-lecture requirements around them, ensuring at least a 30-minute cognitive buffer after lab sessions.
          </p>
        </div>
      </div>
    </section>

    <!-- Bento Grid Section 3: Downloadable Templates Hub (PDF, Excel, Pinterest formats) -->
    <section id="templates-hub" class="scroll-mt-20">
      <div class="p-8 sm:p-12 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] shadow-xs space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-bold tracking-wider text-zinc-500 uppercase">
            TEMPLATES REPOSITORY &bull; MULTI-FORMAT
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
            Downloadable Templates Hub
          </h2>
          <p class="text-xs text-zinc-500 dark:text-zinc-400">
            Export and integrate your schedule across paper planners, digital spreadsheets, and mobile wallpaper.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          
          <!-- Template 1: PDF Printable -->
          <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-800 dark:text-zinc-200">
                <FileText class="w-4 h-4" />
              </div>
              <h3 class="font-bold text-sm text-zinc-900 dark:text-white">Printable PDF Timetable</h3>
              <p class="text-xs text-zinc-500 leading-relaxed">
                Clean A4/Letter vector grid with bold hour lines and room notes for dorm wall pinning.
              </p>
            </div>
            <a 
              href="/editor" 
              class="inline-flex items-center gap-1.5 text-xs font-bold text-zinc-900 dark:text-white hover:underline"
            >
              <span>Build & Print PDF</span>
              <span>&rarr;</span>
            </a>
          </div>

          <!-- Template 2: Excel / Sheets -->
          <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-800 dark:text-zinc-200">
                <FileSpreadsheet class="w-4 h-4" />
              </div>
              <h3 class="font-bold text-sm text-zinc-900 dark:text-white">Excel & Sheets Template</h3>
              <p class="text-xs text-zinc-500 leading-relaxed">
                Structured spreadsheet matrix with conditional formatting and automatic credit sum calculators.
              </p>
            </div>
            <a 
              href="/editor" 
              class="inline-flex items-center gap-1.5 text-xs font-bold text-zinc-900 dark:text-white hover:underline"
            >
              <span>Export in Studio</span>
              <span>&rarr;</span>
            </a>
          </div>

          <!-- Template 3: Pinterest Wallpaper -->
          <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/30 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="w-9 h-9 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-zinc-800 dark:text-zinc-200">
                <Download class="w-4 h-4" />
              </div>
              <h3 class="font-bold text-sm text-zinc-900 dark:text-white">Minimalist Lock Screen PNG</h3>
              <p class="text-xs text-zinc-500 leading-relaxed">
                High-density 2x canvas rendering calibrated for iPhone, iPad, and desktop lock screen backgrounds.
              </p>
            </div>
            <a 
              href="/editor" 
              class="inline-flex items-center gap-1.5 text-xs font-bold text-zinc-900 dark:text-white hover:underline"
            >
              <span>Generate Wallpaper</span>
              <span>&rarr;</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- Bento Grid Section 4: Interactive FAQ Accordions with JSON-LD Schema -->
    <section id="faq" class="scroll-mt-20">
      <div class="p-8 sm:p-12 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] shadow-xs space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-bold tracking-wider text-zinc-500 uppercase">
            FAQ &bull; QUESTIONS & ANSWERS
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
            Frequently Asked Questions
          </h2>
        </div>

        <div class="space-y-3">
          {faqList.map((item) => (
            <details class="group rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/40 p-4 sm:p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer items-center justify-between text-xs sm:text-sm font-bold text-zinc-900 dark:text-white select-none">
                <span>{item.q}</span>
                <span class="ml-4 shrink-0 text-zinc-400 group-open:rotate-180 transition-transform duration-200 text-xs">
                  ▼
                </span>
              </summary>
              <div class="mt-3 text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 border-t border-zinc-200/60 dark:border-zinc-800/60 pt-3">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

  </div>

  <!-- Bottom Hero CTA Banner -->
  <section class="max-w-[1280px] mx-auto px-4 sm:px-6 pb-20">
    <div class="p-8 sm:p-12 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-zinc-950 text-white dark:bg-white dark:text-zinc-950 text-center space-y-4 shadow-xl">
      <h3 class="text-2xl sm:text-4xl font-extrabold tracking-tight">
        Ready to build your conflict-free timetable?
      </h3>
      <p class="text-xs sm:text-sm text-zinc-400 dark:text-zinc-600 max-w-xl mx-auto">
        No accounts, no downloads, zero server tracking. Instant client-side schedule optimization in your browser.
      </p>
      <div class="pt-2">
        <a
          href="/editor"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white text-zinc-950 hover:bg-zinc-100 dark:bg-zinc-950 dark:text-white dark:hover:bg-black font-bold text-xs sm:text-sm transition shadow-sm"
        >
          <span>Open Schedule Studio Now</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </section>

</Layout>
