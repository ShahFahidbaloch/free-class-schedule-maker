---
import Layout from '../layouts/Layout.astro';
import { 
  ArrowRight, 
  Clock, 
  Calendar, 
  BookOpen, 
  Download, 
  FileSpreadsheet, 
  FileText, 
  CheckCircle2,
  CalendarDays,
  Shield,
  Layers,
  Sparkles,
  GraduationCap,
  School,
  Laptop,
  Check,
  Zap,
  Sliders,
  Share2
} from 'lucide-react';

const pageTitle = "Free Class Schedule Maker — Weekly College & School Timetable";
const pageDescription = "Design your ideal class schedule with our free weekly class schedule maker online. Effortlessly create conflict-free college, school, PCC, and UF class schedules with zero gaps. Export to iCal, Google Calendar, and printable PDF.";
const pageKeywords = "class schedule, class schedule maker, free class schedule maker, weekly class schedule maker, class schedule maker template, pcc class schedule, college class schedule, uf class schedule, class schedule maker online, class schedule maker free, school schedule maker";

const faqList = [
  {
    q: "What is a class schedule?",
    a: "A class schedule (also known as a course timetable or academic schedule) is a structured weekly agenda that outlines the specific days, clock times, classroom buildings, and instructors for all registered academic courses in a term. For college and university students, a typical class schedule balances 12 to 18 credit hours spread across Monday/Wednesday/Friday (50-minute lectures) and Tuesday/Thursday (75-minute lectures) blocks, alongside hands-on laboratory or studio periods."
  },
  {
    q: "What is the best class schedule maker online?",
    a: "The best class schedule maker online is our free, browser-based Schedule Studio (/app). It provides an interactive 5-day and 7-day visual matrix (8:00 AM – 8:00 PM), automated side-by-side collision handling for overlapping lectures, a campus dead-time gap optimizer, task deadline tracking, and one-click calendar exports to Apple Calendar, Google Calendar, and printable PDFs—all without requiring an account or email."
  },
  {
    q: "What is a free class schedule maker?",
    a: "A free class schedule maker is a zero-cost digital tool that allows students and teachers to input course codes, meeting times, and locations to generate a visual weekly timetable. Unlike paid software or rigid university registrar systems, our free class schedule maker is 100% free with no paywalls, no sign-ups, and no pop-ups, running entirely in your browser using local storage for complete privacy."
  },
  {
    q: "How to add a class schedule to Google Calendar?",
    a: "To add your class schedule to Google Calendar: (1) Build your weekly timetable in our Schedule Studio (/app). (2) Click 'Export Hub' in the left toolbar and select 'Export .ICS'. (3) Open Google Calendar on your computer. (4) Click the Settings gear icon in the top right and select 'Settings' > 'Import & export'. (5) Under 'Import', click 'Select file from your computer' and upload your downloaded .ics file. (6) Choose your target calendar and click 'Import'. Your entire semester's classes will immediately appear as recurring weekly events with automatic reminders."
  },
  {
    q: "What does a college class schedule look like?",
    a: "A college class schedule looks significantly different from a rigid high school day. Instead of back-to-back classes from 8:00 AM to 3:00 PM every day, a college schedule typically consists of 4 to 5 courses (12–16 credit hours). Most classes follow a split pattern: Monday, Wednesday, and Friday for 50 minutes each (e.g. 10:00 AM – 10:50 AM), or Tuesday and Thursday for 75 minutes each (e.g. 11:00 AM – 12:15 PM). In addition, science and engineering majors usually have a dedicated 3-hour weekly afternoon lab, leaving variable breaks and study blocks between lectures."
  },
  {
    q: "How to import a class schedule into Google Calendar?",
    a: "Importing your class schedule into Google Calendar takes less than a minute using a standard iCalendar (.ics) file. In our Schedule Studio, finalize your course hours and click 'Export .ICS'. Next, visit calendar.google.com, navigate to Settings > Import & Export, select the .ics file from your downloads folder, and click 'Import'. Google Calendar automatically populates all recurring lecture intervals, course codes, and classroom locations for the full 15-week academic semester."
  },
  {
    q: "What is the best free class schedule for students?",
    a: "For university, college, and high school students, Class Schedule Maker is the ideal free schedule tool because it eliminates student registration friction. It requires no login, features an automatic gap-minimization engine to eliminate unproductive 1-to-2 hour campus dead spots, highlights overlapping section conflicts side-by-side, and offers one-click exports to mobile lock-screen wallpapers, spreadsheets, and calendar apps."
  },
  {
    q: "Where can I find a free editable class schedule template?",
    a: "You can customize and download free editable class schedule templates directly from our Templates Hub. Our Schedule Studio exports your personalized weekly schedule into three editable formats: (1) A clean, printable PDF template formatted for US Letter and A4 printing; (2) A structured spreadsheet template compatible with Microsoft Excel and Google Sheets with formula support; and (3) A 2x Retina PNG lock-screen wallpaper for iOS and Android devices."
  },
  {
    q: "What is a free schedule?",
    a: "In academic time management, a 'free schedule' (or unscheduled block) refers to the open, unscheduled hours between or after mandatory classes. A well-designed class schedule consolidates these free hours into large, continuous 3-to-4 hour blocks (rather than scattered 30-minute breaks), allowing students to achieve deep focus for homework, exam preparation, campus jobs, or personal downtime."
  },
  {
    q: "How can I create a fake class schedule?",
    a: "You can create a mock or 'fake' class schedule in seconds using our Schedule Studio (/app) without needing real university credentials. Students frequently generate mock schedules to test 'what-if' registration scenarios before their enrollment window opens, compare alternative professor sections, draft hypothetical syllabi, or generate realistic student timetables for film, theater, and roleplay projects. Simply click '+ Add Class', enter dummy course codes (e.g., CS 101, ART 200), test different day and time slots, and export as a PDF or image."
  },
  {
    q: "How can I create a class schedule?",
    a: "To create a class schedule: (1) Gather your course codes, section times, and building locations from your institution's course catalog. (2) Open our Schedule Studio (/app). (3) Click '+ Add Class' and type the course code and credits. (4) Use the one-click day selector pills to assign days (M, T, W, Th, F). (5) Enter start and end times (e.g., 09:00 AM – 10:15 AM). (6) Review the interactive 5-day grid to ensure no overlapping conflict borders appear. (7) Click 'Export Hub' to save your schedule to Google Calendar, Apple Calendar, or print a PDF."
  },
  {
    q: "How do I find when I'm free in my schedule?",
    a: "To find when you are free, use our visual weekly matrix in the Schedule Studio. The grid clearly maps out your occupied lecture blocks from 08:00 AM to 08:00 PM, making open morning, afternoon, and evening spaces instantly apparent. You can also view the 'Idle Gaps' counter at the top of the studio, which measures total unassigned time between classes, helping you coordinate study groups, work shifts, or extracurricular meetings."
  },
  {
    q: "How do I build a PCC class schedule using this tool?",
    a: "Plan your PCC schedule by entering your 5-digit CRNs, lecture hours, and lab blocks into our Schedule Studio to instantly spot conflicting time slots. For step-by-step registration advice, multi-campus transit times, and IGETC planning, see our dedicated <a href=\"/pcc-class-schedule/\" class=\"underline font-medium text-zinc-900 dark:text-white\">PCC Class Schedule Guide</a>."
  },
  {
    q: "How do I plan my UF class schedule for the University of Florida?",
    a: "Translate your ONE.UF 11-period numbers into standard clock times in our Schedule Studio to spot tight 15-minute cross-campus dashes between Turlington and the engineering quad before Drop/Add week. Read our full <a href=\"/uf-class-schedule/\" class=\"underline font-medium text-zinc-900 dark:text-white\">UF Class Schedule Guide</a> for period conversion charts and campus navigation tips."
  }
];

const structuredSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://freeclassschedule.com/#organization",
      "name": "Class Schedule Maker",
      "url": "https://freeclassschedule.com",
      "logo": "https://freeclassschedule.com/logo.png",
      "founder": {
        "@type": "Person",
        "name": "Shah Fahid",
        "jobTitle": "Full Stack AI Engineer",
        "url": "https://freeclassschedule.com/about/"
      }
    },
    {
      "@type": "WebApplication",
      "@id": "https://freeclassschedule.com/#webapp",
      "name": "Class Schedule Maker & Academic Planner",
      "url": "https://freeclassschedule.com",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "creator": {
        "@type": "Person",
        "name": "Shah Fahid",
        "jobTitle": "Full Stack AI Engineer",
        "url": "https://freeclassschedule.com/about/"
      },
      "description": "Free weekly class schedule maker online. Build conflict-free college, school, PCC, and UF class schedules with automated gap optimization and calendar export.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "5-Day and 7-Day Weekly Class Schedule Matrix",
        "Interactive Overlap and Conflict Detection",
        "Campus Dead-Time Gap Optimizer",
        "PCC and UF University Schedule Planning",
        "Export to Apple Calendar and Google Calendar (.ICS)",
        "Printable PDF and Excel Schedule Maker Templates",
        "Zero Account Required and Client-Side Privacy"
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://freeclassschedule.com/#faq",
      "mainEntity": faqList.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `<p>${item.a}</p>`
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://freeclassschedule.com/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://freeclassschedule.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Schedule Studio",
          "item": "https://freeclassschedule.com/app"
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  schemaJson={structuredSchema}
>
  <!-- Minimalist Hero Section -->
  <section class="w-full max-w-[1280px] mx-auto px-4 sm:px-6 pt-12 sm:pt-20 md:pt-24 pb-10 sm:pb-12 text-center space-y-5 sm:space-y-6">
    
    <!-- Micro Trust Badge -->
    <div class="inline-flex max-w-full items-center gap-2 px-3.5 py-1.5 rounded-full border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 text-[11px] sm:text-xs font-mono font-medium text-zinc-600 dark:text-zinc-400 shadow-2xs text-center">
      <span class="w-1.5 h-1.5 rounded-full bg-zinc-900 dark:bg-white shrink-0"></span>
      <span class="truncate">Free for students &bull; No account needed &bull; 100% Client-Side Private</span>
    </div>

    <!-- Humanized World-Class H1 Headline (Responsive font with no collision) -->
    <h1 class="text-2xl sm:text-4xl md:text-6xl font-bold tracking-tight text-zinc-950 dark:text-white max-w-4xl mx-auto leading-tight sm:leading-[1.1]">
      Build Your Ideal Semester Schedule.
    </h1>

    <!-- Clean, High-Converting Subheadline -->
    <p class="text-sm sm:text-base md:text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl sm:max-w-3xl mx-auto font-normal mt-3 leading-relaxed">
      Effortlessly map your weekly classes, eliminate wasted campus gaps, and export directly to your calendar.
    </p>

    <!-- Central Call To Action Button (Full-width stacked on mobile) -->
    <div class="pt-2 sm:pt-4 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 w-full sm:w-auto max-w-md sm:max-w-none mx-auto">
      <a
        href="/app"
        class="w-full sm:w-auto h-12 px-6 sm:px-8 rounded-xl bg-zinc-950 hover:bg-black text-white dark:bg-white dark:hover:bg-zinc-100 dark:text-zinc-950 text-sm sm:text-base font-bold shadow-md hover:shadow-xl transition-all duration-200 active:scale-[0.98] inline-flex items-center justify-center gap-2"
      >
        <span>Launch Schedule Studio</span>
        <ArrowRight class="w-4 h-4 group-hover:translate-x-1.5 transition-transform" />
      </a>
      <a
        href="#templates-hub"
        class="w-full sm:w-auto h-12 px-6 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 hover:bg-zinc-50 dark:hover:bg-zinc-850 text-zinc-800 dark:text-zinc-200 text-sm font-semibold transition inline-flex items-center justify-center gap-2"
      >
        <FileText class="w-4 h-4" />
        <span>View Free Schedule Templates</span>
      </a>
    </div>

    <!-- Interactive Live Studio Teaser Card -->
    <div class="pt-6 sm:pt-8 w-full max-w-3xl mx-auto">
      <div class="p-4 sm:p-6 rounded-2xl sm:rounded-3xl border border-zinc-200/90 dark:border-zinc-800 bg-white dark:bg-[#121215] shadow-sm space-y-4 text-left">
        <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800 pb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-zinc-300 dark:bg-zinc-700"></span>
            <span class="text-xs font-mono font-semibold text-zinc-600 dark:text-zinc-400 ml-2">ACADEMIC STUDIO &bull; 08:00 AM – 08:00 PM</span>
          </div>
          <span class="hidden sm:inline text-xs font-mono text-zinc-600 dark:text-zinc-400 font-semibold">5-Day / 7-Day Grid Active</span>
        </div>

        <div class="overflow-x-auto w-full pb-1">
          <div class="min-w-[460px] md:min-w-0">
            <div class="grid grid-cols-5 gap-2 text-center text-xs font-bold py-1 text-zinc-600 dark:text-zinc-400">
              <div>Mon</div>
              <div>Tue</div>
              <div>Wed</div>
              <div>Thu</div>
              <div>Fri</div>
            </div>

            <div class="grid grid-cols-5 gap-2 h-24">
              <div class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex flex-col justify-between">
                <span class="font-bold text-xs text-zinc-900 dark:text-white truncate">CS 301</span>
                <span class="text-[10px] font-mono text-zinc-600 dark:text-zinc-400">10:00 - 11:15 AM</span>
              </div>
              <div class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex flex-col justify-between">
                <span class="font-bold text-xs text-zinc-900 dark:text-white truncate">MATH 21</span>
                <span class="text-[10px] font-mono text-zinc-600 dark:text-zinc-400">11:00 - 12:15 PM</span>
              </div>
              <div class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex flex-col justify-between">
                <span class="font-bold text-xs text-zinc-900 dark:text-white truncate">CS 301</span>
                <span class="text-[10px] font-mono text-zinc-600 dark:text-zinc-400">10:00 - 11:15 AM</span>
              </div>
              <div class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex flex-col justify-between">
                <span class="font-bold text-xs text-zinc-900 dark:text-white truncate">MATH 21</span>
                <span class="text-[10px] font-mono text-zinc-600 dark:text-zinc-400">11:00 - 12:15 PM</span>
              </div>
              <div class="p-2 rounded-xl bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 flex flex-col justify-between">
                <span class="font-bold text-xs text-zinc-900 dark:text-white truncate">CS 301</span>
                <span class="text-[10px] font-mono text-zinc-600 dark:text-zinc-400">10:00 - 11:15 AM</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- Editorial & SEO Authority Content Hub (1,200+ Words in Structured Bento Layout) -->
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 py-12 space-y-16">
    
    <!-- Bento Card 1: What is Class Schedule Maker? -->
    <section id="about-tool" class="scroll-mt-20">
      <div class="p-5 sm:p-8 md:p-12 rounded-2xl sm:rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] shadow-xs space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-bold tracking-wider text-zinc-600 dark:text-zinc-400 uppercase">
            OVERVIEW &bull; FREE CLASS SCHEDULE MAKER ONLINE
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
            What is the Class Schedule Maker? The Modern Solution for School and College Students
          </h2>
        </div>

        <div class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed space-y-4">
          <p>
            Planning a university semester or high school term has historically been an exercise in frustration. Students are typically forced to navigate archaic university registrar portals like Ellucian Banner, PeopleSoft, Canvas, or Blackboard on registration morning, frantically juggling course reference numbers (CRNs), course codes, and classroom locations across dozens of open browser tabs.
          </p>

          <p>
            <strong>Class Schedule Maker</strong> was engineered to replace clunky portal interfaces, messy spreadsheets, and paper planners with a fast, zero-distraction <strong>weekly class schedule maker</strong>. As a 100% <strong>free class schedule maker online</strong>, our tool requires no user login, no email submission, and zero software installation. Whether you are mapping out a heavy 16-credit <strong>college class schedule</strong> with 3-hour wet labs, arranging an alternating high school block schedule with our <strong>school schedule maker</strong>, or coordinating lectures across community college campuses, our scheduler renders your full weekly matrix in real time.
          </p>

          <!-- Core Pillars Grid -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
            <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50 space-y-2">
              <div class="w-8 h-8 rounded-lg bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-white font-bold">
                <Zap class="w-4 h-4" />
              </div>
              <h3 class="font-bold text-xs uppercase font-mono text-zinc-900 dark:text-white">
                Zero Latency & Instant Setup
              </h3>
              <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">
                Add courses, credits, meeting days, and venues with a few keystrokes. Toggle multi-day lectures across Monday, Wednesday, and Friday with a single click.
              </p>
            </div>

            <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50 space-y-2">
              <div class="w-8 h-8 rounded-lg bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-white font-bold">
                <Sliders class="w-4 h-4" />
              </div>
              <h3 class="font-bold text-xs uppercase font-mono text-zinc-900 dark:text-white">
                Clash & Overlap Collision Engine
              </h3>
              <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">
                Never miss an accidental time conflict. Overlapping lectures automatically split into parallel side-by-side lanes with an alert border, making double-bookings immediately visible.
              </p>
            </div>

            <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50 space-y-2">
              <div class="w-8 h-8 rounded-lg bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center text-zinc-900 dark:text-white font-bold">
                <Shield class="w-4 h-4" />
              </div>
              <h3 class="font-bold text-xs uppercase font-mono text-zinc-900 dark:text-white">
                100% Client-Side Privacy
              </h3>
              <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">
                Your academic timetable, study tasks, and course notes remain entirely on your device. We do not store, track, or sell your schedule data to third parties.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Bento Card 2: The Science of Gap Minimization in College Class Schedules -->
    <section id="dead-time" class="scroll-mt-20">
      <div class="p-5 sm:p-8 md:p-12 rounded-2xl sm:rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] shadow-xs space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-bold tracking-wider text-zinc-600 dark:text-zinc-400 uppercase">
            ACADEMIC PRODUCTIVITY &bull; TIME BLOCKING SCIENCE
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
            The Cognitive Cost of Campus 'Dead Time' & Gap Minimization in Your Class Schedule
          </h2>
        </div>

        <div class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed space-y-4">
          <p>
            Every college student has endured the frustration of awkward schedule gaps: finishing an introductory lecture at 10:15 AM, only to find their next required lab does not start until 1:00 PM. On paper, two hours and forty-five minutes feels like ample time to study, finish homework, or read textbook chapters in the campus library. In practice, behavioral research and cognitive science prove that fragmented daytime gaps severely destroy student productivity.
          </p>

          <p>
            When you factor in leaving a crowded lecture hall, traversing across campus through rain or snow, hunting for a vacant study desk near a power outlet, unpacking your laptop, and overcoming attention residue, nearly thirty minutes disappear. Then, twenty minutes before your next class begins, you must pack your bag again and walk to the next lecture hall. Your supposed three-hour study window shrinks into a disjointed forty-five minutes of shallow, distracted phone scrolling.
          </p>

          <!-- Bento Inner Highlight Blocks -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50 space-y-2">
              <span class="font-bold text-xs uppercase font-mono text-zinc-900 dark:text-white">
                THE REALITY OF CONTEXT SWITCHING & ATTENTION RESIDUE
              </span>
              <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">
                Switching mental gears between calculus calculations and literary analysis imposes significant cognitive friction. When your weekly schedule forces you into frequent stops and starts, your brain never enters deep focus. You end your day exhausted, yet your main homework remains unfinished.
              </p>
            </div>

            <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50 space-y-2">
              <span class="font-bold text-xs uppercase font-mono text-zinc-900 dark:text-white">
                CONSOLIDATED MORNING BLOCKS (FINISH BY 1:00 PM)
              </span>
              <p class="text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">
                Consolidating your classes back-to-back with clean 15-minute passing walks fundamentally transforms your semester. Finishing lectures by 1:00 PM unlocks a massive, uninterrupted 4-to-5 hour afternoon block for uninterrupted studying, part-time jobs, campus research, or sports.
              </p>
            </div>
          </div>

          <p>
            Our built-in <strong>Auto-Gap Optimizer</strong> automates this time-blocking strategy. Instead of manually cross-referencing dozens of potential section times, our algorithmic engine tests possible class combinations, measures daily idle waiting intervals, and highlights the specific timetable configuration that minimizes campus dead time.
          </p>
        </div>
      </div>
    </section>

    <!-- Bento Card 3: University Schedule Guides: PCC & UF Class Schedule Planning -->
    <section id="course-planning" class="scroll-mt-20">
      <div id="portal-guides" class="-mt-20 pt-20 pointer-events-none"></div>
      <div id="university-guides" class="-mt-20 pt-20 pointer-events-none"></div>
      <div class="p-5 sm:p-8 md:p-12 rounded-2xl sm:rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] shadow-xs space-y-6">
        <div class="space-y-2">
          <span class="text-xs font-mono font-bold tracking-wider text-zinc-600 dark:text-zinc-400 uppercase">
            CAMPUS REGISTRATION &bull; PCC & UF SPECIALIZED GUIDES
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
            University & College Class Schedule Guides: Planning PCC and UF Schedules
          </h2>
          <p class="text-xs text-zinc-600 dark:text-zinc-400">
            Practical strategies for mastering course registration systems at major institutions like PCC and the University of Florida.
          </p>
        </div>

        <div class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed space-y-6">
          
          <!-- Sub-Guide 1: PCC Class Schedule -->
          <div class="p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-900/40 space-y-3">
            <div class="flex items-center gap-2">
              <School class="w-5 h-5 text-zinc-900 dark:text-white" />
              <h3 class="text-base font-bold text-zinc-900 dark:text-white">
                PCC Class Schedule Planning Summary (Pasadena & Portland)
              </h3>
