---
import Layout from '../layouts/Layout.astro';
import SchedulerEngine from '../components/SchedulerEngine';

const faqList = [
  {
    q: "How does the Gap Optimizer algorithm select conflict-free class sections?",
    a: "The engine runs a combinatorial permutation solver across all alternative sections you input. It maps lecture intervals into discrete minutes from midnight, discards any combinations with overlapping intervals [start, end], and then scores valid combinations based on aggregate idle waiting time. It selects the timetable with the absolute minimum campus dead time."
  },
  {
    q: "Why are 1-to-2 hour campus gaps worse for GPA than back-to-back classes?",
    a: "According to research on attention residue by Dr. Sophie Leroy, context-switching between complex subjects incurs a 20-30 minute cognitive penalty. Factoring in packing up, walking across campus quads, finding library seats, and packing up early for the next lecture, a 75-minute gap leaves less than 20 minutes of shallow focus. This fragmented 'limbo state' induces decision fatigue without producing meaningful study progress."
  },
  {
    q: "Can I export my timetable directly to Apple Calendar, Google Calendar, and Outlook?",
    a: "Yes. Clicking 'Export .ICS' generates a standard RFC 5545 iCalendar file configured with 15 weekly recurring events for your semester, complete with 15-minute advance alerts. You can open it natively in Apple Calendar (Mac/iPhone) or import it into Google Calendar and Microsoft Outlook."
  },
  {
    q: "Is any student or university course data stored on external servers?",
    a: "No. The entire scheduler operates under a zero-backend, client-side privacy architecture. All permutation calculations, class timings, and notes are processed locally in your browser and saved exclusively in your private browser localStorage."
  },
  {
    q: "What is the recommended credit distribution between MWF and Tuesday/Thursday?",
    a: "For a standard 15-to-16 credit semester, we recommend an 8/7 or 9/6 distribution: three 3-credit modules on Monday/Wednesday/Friday (50-minute lectures) and two modules on Tuesday/Thursday (75-minute lectures). This prevents mid-week exam crunches and preserves Friday afternoons for project work."
  },
  {
    q: "How should engineering and STEM majors balance 3-hour laboratory blocks?",
    a: "Anchor your low-capacity 3-hour wet or hardware laboratory blocks first, typically on Tuesday or Thursday afternoons. Because lab capacities are limited to 20 seats by bench equipment, their timing cannot be moved. Once anchored, permute your large-lecture requirements around them, ensuring at least a 30-minute cognitive buffer after lab sessions."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
  title="TIMETABLE // OS — Academic Schedule Maker & Gap Optimizer"
  description="High-performance interactive class schedule maker that automatically permutes sections to eliminate awkward campus dead gaps. Export to Apple & Google Calendar."
  schemaJson={faqSchema}
>
  <!-- Hero Section -->
  <section class="pt-14 pb-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <div class="text-center max-w-3xl mx-auto mb-10 space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-mono font-medium bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700">
        <span>TIMETABLE OPTIMIZER // 2026-2027</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-zinc-900 dark:text-white leading-[1.15]">
        Class Schedule Maker <br class="hidden sm:inline" />
        <span class="text-zinc-500 dark:text-zinc-400 font-medium">Without Awkward Campus Gaps</span>
      </h1>

      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto leading-relaxed">
        Input your courses and sections. The combinatorial solver eliminates wasted idle hours, detects lecture collisions in real time, and exports seamlessly to Apple and Google Calendar.
      </p>
    </div>

    <!-- The Interactive Scheduler Console -->
    <div class="mt-4">
      <SchedulerEngine client:load />
    </div>
  </section>

  <!-- Editorial & Knowledge Base (shadcn/ui Bento Grid Layout) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-24">

    <!-- Bento Section 1: How the Gap Minimizer Works -->
    <section id="how-it-works" class="space-y-6">
      <div class="space-y-1">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-500">
          ALGORITHM ARCHITECTURE
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
          The Mathematics of Gap Optimization
        </h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-3xl leading-relaxed">
          Standard university portals lack cross-section permutation intelligence. Below is a real-world comparison of an unoptimized random section draw versus our conflict-free compact schedule.
        </p>
      </div>

      <!-- Before / After Bento Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Before Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-zinc-100 dark:border-zinc-800">
            <span class="text-xs font-bold text-rose-600 dark:text-rose-400 font-mono flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-rose-500"></span> UNOPTIMIZED REGISTRATION
            </span>
            <span class="text-xs font-mono font-semibold text-rose-600 dark:text-rose-400 bg-rose-50 dark:bg-rose-950/60 px-2 py-0.5 rounded border border-rose-200 dark:border-rose-900">
              3.5H IDLE GAP
            </span>
          </div>

          <div class="space-y-3 text-xs">
            <div class="p-3.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200/80 dark:border-zinc-700/80 flex items-center justify-between">
              <div>
                <span class="font-bold text-zinc-900 dark:text-white">10:00 AM – 11:15 AM</span>
                <div class="text-zinc-500">Chemistry 101 Lecture</div>
              </div>
              <span class="font-mono text-zinc-400">Science Hall</span>
            </div>

            <!-- Dead Gap Indicator -->
            <div class="p-4 rounded-xl bg-rose-50/60 dark:bg-rose-950/30 border border-dashed border-rose-300 dark:border-rose-800 text-center space-y-1">
              <span class="font-bold text-rose-700 dark:text-rose-300 text-xs">
                3-Hour 30-Minute Campus Dead Gap (11:15 AM – 2:45 PM)
              </span>
              <p class="text-[11px] text-rose-600/90 dark:text-rose-400/90 leading-relaxed">
                Too short to commute home, crowded library desks, high context-switching fatigue, distracted browsing.
              </p>
            </div>

            <div class="p-3.5 rounded-xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200/80 dark:border-zinc-700/80 flex items-center justify-between">
              <div>
                <span class="font-bold text-zinc-900 dark:text-white">02:45 PM – 04:00 PM</span>
                <div class="text-zinc-500">Linear Algebra Lecture</div>
              </div>
              <span class="font-mono text-zinc-400">Math Quad</span>
            </div>
          </div>

          <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed pt-1">
            <strong>Cognitive Penalty:</strong> Dr. Sophie Leroy's attention residue research shows that task transitions without closure diminish analytical performance on subsequent lectures by up to 28%.
          </p>
        </div>

        <!-- After Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-zinc-100 dark:border-zinc-800">
            <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 font-mono flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span> GAP-OPTIMIZED PERMUTATION
            </span>
            <span class="text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-200 dark:border-emerald-900">
              0 IDLE MINUTES
            </span>
          </div>

          <div class="space-y-3 text-xs">
            <div class="p-3.5 rounded-xl bg-emerald-50/70 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-800/80 flex items-center justify-between">
              <div>
                <span class="font-bold text-emerald-950 dark:text-emerald-200">10:00 AM – 11:15 AM</span>
                <div class="text-emerald-700 dark:text-emerald-400">Chemistry 101 (Section 01)</div>
              </div>
              <span class="font-mono text-emerald-600">MWF</span>
            </div>

            <!-- Passing Period -->
            <div class="py-2 px-3 rounded-lg bg-zinc-100 dark:bg-zinc-800 text-center text-[11px] font-mono text-zinc-600 dark:text-zinc-300">
              15-Minute Direct Quad Passing Walk
            </div>

            <div class="p-3.5 rounded-xl bg-blue-50/70 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800/80 flex items-center justify-between">
              <div>
                <span class="font-bold text-blue-950 dark:text-blue-200">11:30 AM – 12:45 PM</span>
                <div class="text-blue-700 dark:text-blue-400">Linear Algebra (Section 02)</div>
              </div>
              <span class="font-mono text-blue-600">MWF</span>
            </div>

            <div class="p-3.5 rounded-xl bg-emerald-50/80 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-center">
              <span class="font-semibold text-emerald-900 dark:text-emerald-200 block text-xs">
                Entire Afternoon Unlocked (12:45 PM Onward)
              </span>
              <span class="text-[11px] text-emerald-700 dark:text-emerald-400 font-mono">
                Preserves a 4-hour contiguous block for internships, laboratory benchwork, or deep study.
              </span>
            </div>
          </div>

          <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed pt-1">
            <strong>Algorithmic Result:</strong> The solver computes the Cartesian product of all active course sections, checks for pairwise interval intersection <code>max(s1, s2) &lt; min(e1, e2)</code>, and scores candidate permutations.
          </p>
        </div>
      </div>
    </section>

    <!-- Bento Section 2: Downloadable Formats -->
    <section id="templates" class="space-y-6">
      <div class="space-y-1">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-500">
          EXPORT PIPELINE
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
          Downloadable Schedule Formats
        </h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-3xl leading-relaxed">
          One-click synchronization with standard collegiate software ecosystems.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <!-- PDF / Print Sheet Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-3 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-9 h-9 rounded-lg bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center font-mono font-bold text-xs text-zinc-800 dark:text-zinc-200">
              PDF
            </div>
            <h3 class="text-sm font-bold text-zinc-900 dark:text-white tracking-tight">Printable PDF Timetable</h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
              Clean print stylesheet formatted for standard A4 and US Letter dimensions. Ideal for dorm pinboards and physical binders.
            </p>
          </div>
          <button onclick="window.print()" class="text-xs font-semibold text-zinc-900 dark:text-white hover:underline text-left cursor-pointer pt-2">
            Print Timetable Sheet →
          </button>
        </div>

        <!-- Apple / Google iCal Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-3 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-9 h-9 rounded-lg bg-blue-50 dark:bg-blue-950/60 flex items-center justify-center font-mono font-bold text-xs text-blue-600 dark:text-blue-400">
              ICS
            </div>
            <h3 class="text-sm font-bold text-zinc-900 dark:text-white tracking-tight">Apple & Google Calendar Sync</h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
              Standard RFC 5545 `.ics` file with weekly recurring `RRULE` entries for 15 weeks, including automated 15-minute departure alarms.
            </p>
          </div>
          <button onclick="document.getElementById('action-export-ics')?.click()" class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline text-left cursor-pointer pt-2">
            Download .ICS File →
          </button>
        </div>

        <!-- Wallpaper PNG Card -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-3 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="w-9 h-9 rounded-lg bg-purple-50 dark:bg-purple-950/60 flex items-center justify-center font-mono font-bold text-xs text-purple-600 dark:text-purple-400">
              PNG
            </div>
            <h3 class="text-sm font-bold text-zinc-900 dark:text-white tracking-tight">iPad Wallpaper & Lock Screen</h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
              2x pixel-ratio PNG render designed for iPad GoodNotes covers, lock screens, and desktop secondary displays.
            </p>
          </div>
          <button onclick="document.querySelector('[title*=\'Download high-resolution\']')?.click()" class="text-xs font-semibold text-purple-600 dark:text-purple-400 hover:underline text-left cursor-pointer pt-2">
            Capture PNG Image →
          </button>
        </div>
      </div>
    </section>

    <!-- Bento Section 3: Strategic Planning Guide -->
    <section id="guide" class="space-y-6">
      <div class="space-y-1">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-500">
          CURRICULUM PLANNING
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
          The Collegiate Course Planning Framework
        </h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-3xl leading-relaxed">
          Structuring a 15-to-18 credit hour semester requires balancing contact hours, quantitative problem sets, and physical laboratory fatigue.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Rule 1 -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-3">
          <div class="font-mono text-xs font-bold text-zinc-400">RULE 01 // LOAD DISTRIBUTION</div>
          <h3 class="text-base font-bold text-zinc-900 dark:text-white">The 2:2:1 Workload Balance</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Never enroll in four quantitative problem-solving courses in a single semester. A balanced 15-credit load consists of:
          </p>
          <ul class="text-xs text-zinc-600 dark:text-zinc-400 space-y-1.5 list-disc pl-4">
            <li><strong>2 Quantitative Major Core</strong> (e.g. Calculus, Data Structures)</li>
            <li><strong>2 Qualitative Seminars</strong> (e.g. History, Economics, Ethics)</li>
            <li><strong>1 Applied Practical Lab</strong> (Wet lab, Design Studio, Music)</li>
          </ul>
        </div>

        <!-- Rule 2 -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-3">
          <div class="font-mono text-xs font-bold text-zinc-400">RULE 02 // CHRONOBIOLOGY</div>
          <h3 class="text-base font-bold text-zinc-900 dark:text-white">The 8:00 AM Reality Check</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Collegiate chronobiology research indicates that prefrontal executive function and working memory capacity peak between 9:00 AM and 11:30 AM for young adults.
          </p>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Scheduling quantitative exams or rigorous lectures at 8:00 AM correlates with higher absenteeism and an average 0.35 GPA decrease relative to 9:30 AM starts.
          </p>
        </div>

        <!-- Rule 3 -->
        <div class="p-6 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 shadow-sm space-y-3">
          <div class="font-mono text-xs font-bold text-zinc-400">RULE 03 // LAB BUFFERING</div>
          <h3 class="text-base font-bold text-zinc-900 dark:text-white">Anchoring 3-Hour Lab Blocks</h3>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Laboratory sections possess restricted physical capacity (typically 18-24 bench workstations). Because they cannot be rescheduled, anchor them first.
          </p>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Always reserve a mandatory 45-minute buffer after a 3-hour wet laboratory block before attending any discussion section or test.
          </p>
        </div>
      </div>
    </section>

    <!-- Bento Section 4: Timetable Architecture Comparison -->
    <section id="models" class="space-y-6">
      <div class="space-y-1">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-500">
          SYSTEM EVALUATION
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
          Timetable Architectures Compared
        </h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-3xl leading-relaxed">
          Choose a schedule archetype tailored to your commuting distance, athletic commitments, or undergraduate research schedule.
        </p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shadow-sm">
        <table class="w-full text-left text-xs">
          <thead class="bg-zinc-50 dark:bg-zinc-800/80 text-zinc-900 dark:text-white border-b border-zinc-200 dark:border-zinc-800 font-mono">
            <tr>
              <th class="py-3.5 px-4 font-semibold">MODEL ARCHITECTURE</th>
              <th class="py-3.5 px-4 font-semibold">WEEKLY RHYTHM</th>
              <th class="py-3.5 px-4 font-semibold">CORE ADVANTAGE</th>
              <th class="py-3.5 px-4 font-semibold">ACADEMIC RISK</th>
              <th class="py-3.5 px-4 font-semibold">RECOMMENDED PROFILE</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800 text-zinc-600 dark:text-zinc-300">
            <tr>
              <td class="py-3.5 px-4 font-bold text-zinc-900 dark:text-white">Block Scheduling (Compact)</td>
              <td class="py-3.5 px-4 font-mono text-zinc-500">T/Th or MWF Only</td>
              <td class="py-3.5 px-4">Frees 2–3 full weekdays for uninterrupted engineering co-ops and off-campus internships.</td>
              <td class="py-3.5 px-4 text-rose-600 dark:text-rose-400">High exam-day cognitive fatigue; 3 finals can land on the same day.</td>
              <td class="py-3.5 px-4">Commuter students & working professionals.</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-bold text-zinc-900 dark:text-white">Uniform Alternating Spread</td>
              <td class="py-3.5 px-4 font-mono text-zinc-500">MWF (50m) + TTh (75m)</td>
              <td class="py-3.5 px-4">Consistent circadian rhythm; distributed daily homework pace.</td>
              <td class="py-3.5 px-4 text-amber-600 dark:text-amber-400">Requires daily commute; limits 4-hour deep-work blocks.</td>
              <td class="py-3.5 px-4">Freshmen & on-campus residential students.</td>
            </tr>
            <tr>
              <td class="py-3.5 px-4 font-bold text-zinc-900 dark:text-white">Hybrid Anchor Model</td>
              <td class="py-3.5 px-4 font-mono text-zinc-500">Heavy TTh + Light MW</td>
              <td class="py-3.5 px-4">Accommodates 3-hour lab sections cleanly; Friday afternoon free.</td>
              <td class="py-3.5 px-4 text-zinc-500">Requires proactive self-discipline on light lecture days.</td>
              <td class="py-3.5 px-4">STEM, Pre-Med, and Computer Science majors.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Bento Section 5: Clean Minimalist Accordion FAQs -->
    <section id="faq" class="space-y-6">
      <div class="space-y-1">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-zinc-500">
          DOCUMENTATION & FAQ
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-900 dark:text-white">
          Frequently Asked Questions
        </h2>
        <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-3xl leading-relaxed">
          Answers to technical questions regarding permutation algorithms, calendar exports, and privacy architecture.
        </p>
      </div>

      <div class="space-y-3">
        {faqList.map((item) => (
          <details class="group rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 p-5 transition-all shadow-2xs [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold text-zinc-900 dark:text-white select-none">
              <span>{item.q}</span>
              <span class="ml-4 shrink-0 text-zinc-400 transition-transform duration-200 group-open:rotate-180">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </span>
            </summary>
            <div class="mt-3.5 text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 border-t border-zinc-100 dark:border-zinc-800/80 pt-3.5">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </section>

  </div>
</Layout>
