---
import Layout from '../layouts/Layout.astro';
import SchedulerEngine from '../components/SchedulerEngine';

const faqList = [
  {
    q: "How does the Gap Optimizer algorithm select conflict-free class sections?",
    a: "The engine runs a combinatorial permutation solver across all alternative sections you input. It maps lecture intervals into discrete minutes from midnight, discards any combinations with overlapping intervals [start, end], and then scores valid combinations based on aggregate idle waiting time. It selects the timetable with the absolute minimum campus dead time."
  },
  {
    q: "Why are 1-to-2 hour campus gaps worse for GPA than back-to-back classes?",
    a: "According to research on attention residue by Dr. Sophie Leroy, context-switching between complex subjects incurs a 20-30 minute cognitive penalty. Factoring in packing up, walking across campus quads, finding library seats, and packing up early for the next lecture, a 75-minute gap leaves less than 20 minutes of shallow focus. This fragmented 'limbo state' induces decision fatigue without producing meaningful study progress."
  },
  {
    q: "Can I export my timetable directly to Apple Calendar, Google Calendar, and Outlook?",
    a: "Yes. Clicking 'Export ICS' generates a standard RFC 5545 iCalendar file configured with 15 weekly recurring events for your semester, complete with 15-minute advance alerts. You can open it natively in Apple Calendar (Mac/iPhone) or import it into Google Calendar and Microsoft Outlook."
  },
  {
    q: "Is any student or university course data stored on external servers?",
    a: "No. The entire scheduler operates under a zero-backend, client-side privacy architecture. All permutation calculations, class timings, and notes are processed locally in your browser and saved exclusively in your private browser localStorage."
  },
  {
    q: "What is the recommended credit distribution between MWF and Tuesday/Thursday?",
    a: "For a standard 15-to-16 credit semester, we recommend an 8/7 or 9/6 distribution: three 3-credit modules on Monday/Wednesday/Friday (50-minute lectures) and two modules on Tuesday/Thursday (75-minute lectures). This prevents mid-week exam crunches and preserves Friday afternoons for project work."
  },
  {
    q: "How should engineering and STEM majors balance 3-hour laboratory blocks?",
    a: "Anchor your low-capacity 3-hour wet or hardware laboratory blocks first, typically on Tuesday or Thursday afternoons. Because lab capacities are limited to 20 seats by bench equipment, their timing cannot be moved. Once anchored, permute your large-lecture requirements around them, ensuring at least a 30-minute cognitive buffer after lab sessions."
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout 
  title="Class Schedule — College Timetable & Gap Optimizer"
  description="Free interactive Class Schedule Maker and Timetable Optimizer. Eliminate awkward campus gaps and export conflict-free schedules to Apple & Google Calendar."
  schemaJson={faqSchema}
>
  <!-- Zero-Scroll Top Workbench (Above the Fold) -->
  <div class="max-w-[1536px] mx-auto px-3 sm:px-6 pt-2 pb-6">
    <SchedulerEngine client:load />
  </div>

  <!-- Collapsed Academic Planning Hub & SEO Documentation (For AdSense & Reference) -->
  <div class="max-w-[1536px] mx-auto px-3 sm:px-6 py-6 border-t border-zinc-200 dark:border-zinc-800/80 editorial-hub">
    <details id="editorial-hub" class="group rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] transition-all shadow-2xs [&_summary::-webkit-details-marker]:hidden">
      <summary class="flex cursor-pointer items-center justify-between p-4 sm:p-5 select-none text-zinc-900 dark:text-white">
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 rounded-xs bg-zinc-400 dark:bg-zinc-600"></span>
          <span class="text-xs font-semibold uppercase tracking-wider">
            Class Schedule Guide, Timetable Optimization & Student FAQ
          </span>
          <span class="text-[11px] text-zinc-400 hidden sm:inline">
            — Course planning tips, gap reduction strategies & schedule FAQs
          </span>
        </div>
        <span class="text-xs font-mono text-zinc-400 group-open:rotate-180 transition-transform duration-200">
          ▼
        </span>
      </summary>

      <!-- Expandable Deep Editorial Content -->
      <div class="p-6 sm:p-8 border-t border-zinc-100 dark:border-zinc-800/60 space-y-16 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
        
        <!-- Section 1: The Mathematics of Timetable Gap Optimization -->
        <section class="space-y-4">
          <div class="space-y-1">
            <span class="text-[11px] font-mono font-bold uppercase text-zinc-500">ALGORITHM SPECIFICATION</span>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
              The Mathematics of Timetable Gap Optimization: Permutation Checks & Interval Algorithms
            </h2>
          </div>

          <p>
            University course registration is a classic discrete combinatorial optimization problem analogous to the Boolean Satisfiability (SAT) and Exact Cover problems. When an undergraduate student enrolls in 5 academic courses with multiple alternative lecture sections, recitations, and lab blocks, the parameter search space grows factorially.
          </p>

          <div class="p-4 rounded-lg bg-zinc-50 dark:bg-zinc-900 font-mono text-xs text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-zinc-800">
            Combinatorial Permutations: S = &prod; |Sec_i| = 3 &times; 3 &times; 3 &times; 3 &times; 3 = 243 discrete candidate timetables
          </div>

          <p>
            Our engine processes this search space through a two-stage deterministic resolution:
          </p>
          <ul class="list-disc pl-5 space-y-2">
            <li>
              <strong>Stage 1 (Overlap Pruning):</strong> Maps all class timing intervals into integer minutes from midnight. For every candidate section pairing occurring on the same day with intervals [s₁, e₁] and [s₂, e₂], the algorithm verifies that <code>max(s₁, s₂) &ge; min(e₁, e₂)</code>. If an overlap is identified, the candidate branch is immediately pruned.
            </li>
            <li>
              <strong>Stage 2 (Cost Function Evaluation):</strong> For remaining non-conflicting permutations, the engine calculates the idle interval duration between consecutive lectures and minimizes the total weekly gap score.
            </li>
          </ul>

          <!-- Before/After Scientific Breakdown -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/40 space-y-2">
              <span class="font-mono font-bold text-xs text-rose-600 dark:text-rose-400">UNOPTIMIZED SCHEDULE (3.5H DEAD GAP)</span>
              <p class="text-xs">
                Students stranded between 11:15 AM and 2:45 PM suffer from cognitive attention residue. Research by Dr. Sophie Leroy indicates transitions without task closure impair performance on subsequent analytical tasks by 28%.
              </p>
            </div>
            <div class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/40 space-y-2">
              <span class="font-mono font-bold text-xs text-zinc-900 dark:text-white">OPTIMIZED SCHEDULE (15M PASSING WALK)</span>
              <p class="text-xs">
                Back-to-back lectures consolidate cognitive focus in the morning, freeing the entire afternoon from 12:45 PM onward for uninterrupted 4-hour study sessions or lab work.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 2: Strategic College Course Planning Guide -->
        <section id="planning-guide" class="space-y-4 pt-4 scroll-mt-20">
          <div class="space-y-1">
            <span class="text-[11px] font-mono font-bold uppercase text-zinc-500">CURRICULUM PLANNING FRAMEWORK</span>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
              Strategic College Course Planning Guide: The Golden 15-Credit Balance
            </h2>
          </div>

          <p>
            Graduating within four academic years requires completing 120 semester credit hours (averaging 15 credits per semester). However, treating all credit hours as equivalent units causes severe midterm exam clustering and GPA burnout.
          </p>

          <div class="space-y-3">
            <h3 class="text-base font-semibold text-zinc-900 dark:text-white">The 2:2:1 Workload Balancing Formula</h3>
            <ul class="list-disc pl-5 space-y-2">
              <li>
                <strong>Two Quantitative Heavyweights (6–8 Credits):</strong> Rigorous major requirements (e.g. Data Structures, Multivariable Calculus, Organic Chemistry) demanding continuous weekly problem set calculations.
              </li>
              <li>
                <strong>Two Qualitative Seminars (6 Credits):</strong> Writing-intensive breadth electives or institutional general education requirements evaluated primarily via mid-term essays.
              </li>
              <li>
                <strong>One Applied Practical / Kinetic Lab (1–3 Credits):</strong> Hardware engineering laboratories or design studios engaging sensory faculties rather than textbook reading memory.
              </li>
            </ul>
          </div>

          <div class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/40 space-y-2">
            <h4 class="font-bold text-zinc-900 dark:text-white text-xs">Managing 3-Hour Wet/Dry Laboratory Blocks</h4>
            <p class="text-xs">
              Laboratory sections require physical bench equipment, restricting capacity to 18-24 students. Because lab times cannot be moved, anchor them on Tuesday or Thursday afternoons first, then permute high-capacity lecture sections around them. Always ensure a 45-minute recovery buffer following any 3-hour lab block.
            </p>
          </div>
        </section>

        <!-- Section 3: Timetable Architectures Comparison -->
        <section class="space-y-4">
          <div class="space-y-1">
            <span class="text-[11px] font-mono font-bold uppercase text-zinc-500">COMPARATIVE ARCHITECTURE</span>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
              Timetable Architectures Comparison: Evaluating Block vs Alternating vs Hybrid Models
            </h2>
          </div>

          <div class="overflow-x-auto rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900">
            <table class="w-full text-left text-xs">
              <thead class="bg-zinc-50 dark:bg-zinc-800/80 text-zinc-900 dark:text-white border-b border-zinc-200 dark:border-zinc-800 font-mono">
                <tr>
                  <th class="py-3 px-4 font-semibold">MODEL ARCHITECTURE</th>
                  <th class="py-3 px-4 font-semibold">WEEKLY RHYTHM</th>
                  <th class="py-3 px-4 font-semibold">CORE ADVANTAGE</th>
                  <th class="py-3 px-4 font-semibold">ACADEMIC RISK</th>
                  <th class="py-3 px-4 font-semibold">RECOMMENDED PROFILE</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800 text-zinc-600 dark:text-zinc-300">
                <tr>
                  <td class="py-3 px-4 font-bold text-zinc-900 dark:text-white">Block Scheduling (Compact)</td>
                  <td class="py-3 px-4 font-mono text-zinc-500">T/Th or MWF Only</td>
                  <td class="py-3 px-4">Frees 2–3 full weekdays for uninterrupted co-ops and research.</td>
                  <td class="py-3 px-4 text-rose-600 dark:text-rose-400">High exam-day cognitive fatigue.</td>
                  <td class="py-3 px-4">Commuter students & working professionals.</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-bold text-zinc-900 dark:text-white">Uniform Alternating Spread</td>
                  <td class="py-3 px-4 font-mono text-zinc-500">MWF (50m) + TTh (75m)</td>
                  <td class="py-3 px-4">Consistent circadian rhythm; distributed daily homework pace.</td>
                  <td class="py-3 px-4 text-amber-600 dark:text-amber-400">Requires daily commute; limits 4-hour deep-work blocks.</td>
                  <td class="py-3 px-4">Freshmen & on-campus residential students.</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 font-bold text-zinc-900 dark:text-white">Hybrid Anchor Model</td>
                  <td class="py-3 px-4 font-mono text-zinc-500">Heavy TTh + Light MW</td>
                  <td class="py-3 px-4">Accommodates 3-hour lab sections cleanly; Friday afternoon free.</td>
                  <td class="py-3 px-4 text-zinc-500">Requires self-discipline on light lecture days.</td>
                  <td class="py-3 px-4">STEM, Pre-Med, and Computer Science majors.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section 4: Downloadable Schedule Formats -->
        <section class="space-y-4">
          <div class="space-y-1">
            <span class="text-[11px] font-mono font-bold uppercase text-zinc-500">DOCUMENTATION</span>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
              Supported Export Formats & Standards
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/40 space-y-1.5">
              <span class="font-mono font-bold text-xs text-zinc-900 dark:text-white">RFC 5545 iCALENDAR (.ICS)</span>
              <p class="text-xs">
                Standard recurring calendar syntax with 15-week semester repeat rules and 15-minute advance alarms for Apple Calendar, Google Calendar, and Microsoft Outlook.
              </p>
            </div>
            <div class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/40 space-y-1.5">
              <span class="font-mono font-bold text-xs text-zinc-900 dark:text-white">WALLPAPER PNG (2X DENSITY)</span>
              <p class="text-xs">
                High-definition canvas rendering optimized for iPad GoodNotes covers, lock screens, and secondary desktop monitor display.
              </p>
            </div>
            <div class="p-4 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/40 space-y-1.5">
              <span class="font-mono font-bold text-xs text-zinc-900 dark:text-white">PRINT MEDIA CSS (A4/LETTER)</span>
              <p class="text-xs">
                Custom CSS media query stripping all web navigation, form controls, and theme toggles for paper noticeboard pinning.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 5: Frequently Asked Questions -->
        <section id="faq" class="space-y-4 pt-4 scroll-mt-20">
          <div class="space-y-1">
            <span class="text-[11px] font-mono font-bold uppercase text-zinc-500">FAQ REPOSITORY</span>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-white">
              Frequently Asked Questions: College Schedule & Gap Optimization
            </h2>
          </div>

          <div class="space-y-2">
            {faqList.map((item) => (
              <details class="group rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/40 p-4 transition-all [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex cursor-pointer items-center justify-between text-xs sm:text-sm font-semibold text-zinc-900 dark:text-white select-none">
                  <span>{item.q}</span>
                  <span class="ml-4 shrink-0 text-zinc-400 group-open:rotate-180 transition-transform duration-200">
                    ▼
                  </span>
                </summary>
                <div class="mt-3 text-xs leading-relaxed text-zinc-600 dark:text-zinc-400 border-t border-zinc-200/60 dark:border-zinc-800/60 pt-3">
                  {item.a}
                </div>
              </details>
            ))}
          </div>
        </section>

      </div>
    </details>
  </div>
</Layout>
