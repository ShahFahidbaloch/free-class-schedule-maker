---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="404 — Page Not Found | Free Class Schedule Maker"
  description="The academic page or schedule you requested could not be located."
>
  <div class="max-w-xl mx-auto px-4 py-28 text-center space-y-6">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800 text-zinc-900 dark:text-white font-mono text-xl font-bold">
      404
    </div>
    <div class="space-y-2">
      <h1 class="text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">
        Schedule Interval Not Found
      </h1>
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        The link you followed may be expired or the requested URL does not exist on this server.
      </p>
    </div>
    <div>
      <a 
        href="/"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-950 text-xs font-semibold hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-colors shadow-xs"
      >
        Return to Schedule Optimizer
      </a>
    </div>
  </div>
</Layout>

