---
import Layout from '../layouts/Layout.astro';
import { 
  Briefcase, 
  ArrowRight, 
  Clock, 
  CalendarDays, 
  Sparkles, 
  Printer, 
  FileText, 
  BookOpen, 
  CheckCircle2,
  Coffee,
  Users
} from 'lucide-react';

const pageTitle = "Teacher Schedule Maker — Free Classroom Timetable & Prep Period Planner";
const pageDescription = "Free teacher schedule maker for K-12 educators and professors. Plan teaching periods, prep hours, duty shifts, and printable classroom door postings.";
const pageKeywords = "teacher schedule maker, classroom schedule planner, teacher prep period planner, teacher timetable maker, school teacher schedule template, substitute teacher schedule";

const faqs = [
  {
    q: "How do teachers clearly differentiate teaching periods from prep time on a schedule?",
    a: "Teachers differentiate instructional periods from non-teaching blocks by using distinct color palettes in Schedule Studio. Assign bold tag colors to direct student classes (e.g. Algebra I in Slate, Geometry in Sky), and assign neutral muted tones to planning periods, department collaboration, and office hours. This provides instant visual clarity on when your classroom door is open to visitors."
  },
  {
    q: "What is the best format for a classroom door schedule for students and substitute teachers?",
    a: "The best classroom door schedule is a high-contrast, black-and-white vector PDF printout listing period numbers, exact clock start and end times, subject titles, and teacher room locations. In Schedule Studio (/app), click 'Print / Save as PDF' to generate an ink-friendly A4 or US Letter chart ready to laminate and affix beside your classroom entrance or include in emergency substitute folders."
  },
  {
    q: "How do I schedule rotating duties like cafeteria monitoring or bus supervision?",
    a: "In Schedule Studio, click '+ Add Class' to create a dedicated duty block (e.g., 'Morning Bus Duty' or 'Hallway Supervision'). Use the one-click day selector pills to assign specific duty days (such as Monday and Thursday from 07:30 to 07:55 AM) to prevent supervision commitments from overlapping with your classroom prep routines."
  },
  {
    q: "Can teachers sync their classroom schedule with Google Calendar and Microsoft Outlook?",
    a: "Yes. Once your class periods, prep hours, and faculty meetings are mapped in Schedule Studio, open the Export Hub and click 'Apple & Google Calendar (.ICS)'. Import the downloaded file into Google Calendar or Microsoft Outlook (commonly used by school districts) to populate all 180 annual school days with 10-minute transition chimes."
  },
  {
    q: "Is Free Class Schedule Maker compliant with school district student privacy policies?",
    a: "Yes. Our tool is 100% client-side and FERPA-compliant because no student names, grades, or personal identifying data are ever requested or stored on external servers. All teacher lesson plans and timetable configurations remain solely inside your browser's local cache on your school laptop."
  }
];

const structuredSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": "https://freeclassschedule.com/teacher-schedule-maker/#webapp",
      "name": "Teacher Schedule Maker",
      "url": "https://freeclassschedule.com/teacher-schedule-maker",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "description": pageDescription,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@type": "FAQPage",
      "@id": "https://freeclassschedule.com/teacher-schedule-maker/#faq",
      "mainEntity": faqs.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": `<p>${item.a}</p>`
        }
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://freeclassschedule.com/teacher-schedule-maker/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://freeclassschedule.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Teacher Schedule Maker",
          "item": "https://freeclassschedule.com/teacher-schedule-maker"
        }
      ]
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  schemaJson={structuredSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-12 sm:space-y-16">
    
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-zinc-500">
      <a href="/" class="hover:underline">Home</a>
      <span>/</span>
      <span class="text-zinc-800 dark:text-zinc-200">Teacher Schedule Maker</span>
    </nav>

    <!-- Hero Header -->
    <header class="space-y-4 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-lg text-xs font-medium bg-sky-50 dark:bg-sky-950/40 text-sky-800 dark:text-sky-200 border border-sky-200 dark:border-sky-900 shadow-2xs">
        <Briefcase class="w-4 h-4 text-sky-600 dark:text-sky-400" />
        <span>Educator Productivity &bull; Classroom Planning &amp; Prep Period Management</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-950 dark:text-white leading-tight">
        Teacher Schedule Maker: Master Instructional Blocks, Prep Periods, and Duties
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-3xl leading-relaxed">
        Teaching requires juggling multiple course sections, protected planning periods, IEP conferences, bus supervision, and parent office hours. Design an organized classroom timetable, prevent meeting encroachment, and print clean classroom door postings in seconds.
      </p>

      <!-- Primary Top CTA -->
      <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <a 
          href="/app" 
          class="h-12 px-6 rounded-xl bg-zinc-950 hover:bg-black text-white dark:bg-white dark:hover:bg-zinc-100 dark:text-zinc-950 font-bold text-sm inline-flex items-center justify-center gap-2 shadow-sm transition active:scale-[0.98]"
        >
          <span>Open Schedule Studio</span>
          <ArrowRight class="w-4 h-4" />
        </a>
        <a 
          href="/class-schedule-template" 
          class="h-12 px-5 rounded-xl border border-zinc-200 dark:border-zinc-800 hover:bg-zinc-50 dark:hover:bg-zinc-900 text-zinc-800 dark:text-zinc-200 font-semibold text-sm inline-flex items-center justify-center gap-2 transition"
        >
          <span>Printable Door Postings</span>
        </a>
      </div>
    </header>

    <!-- Visual Interactive Timetable Preview -->
    <figure class="rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900/50 p-2 sm:p-3 my-6">
      <img 
        src="/images/studio-preview.png" 
        alt="Teacher schedule maker interface displaying instructional classes, protected prep period, lunch break, and bus duty blocks" 
        width="1200" 
        height="700" 
        loading="lazy" 
        class="w-full h-auto rounded-xl shadow-xs"
      />
      <figcaption class="text-[11px] font-mono text-zinc-500 text-center py-2">
        Figure 1: Schedule Studio weekly matrix showing color-coded teaching periods, prep blocks, and daily duty slots.
      </figcaption>
    </figure>

    <!-- Article Content -->
    <article class="prose prose-zinc dark:prose-invert max-w-none text-sm sm:text-base leading-relaxed space-y-8">
      
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">
          Why Educators Need a Dedicated Teacher Schedule Maker
        </h2>
        <p class="font-medium text-zinc-900 dark:text-zinc-100">
          A teacher schedule maker is a specialized timetable planner designed to map instructional class periods alongside non-teaching commitments such as prep periods, department meetings, IEP conferences, and campus duty. Unlike student timetables, an educator schedule must protect grading hours, establish clear substitute teacher protocols, and produce clean classroom door postings for administrators and students.
        </p>
        <p>
          District master schedulers provide teachers with list-based class assignments (e.g. Period 1: Algebra I, Period 2: Algebra I, Period 3: Planning). However, a simple period list fails to reveal the true operational flow of an educator's day:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 not-prose">
          <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50 space-y-2">
            <span class="text-xs font-mono font-bold text-sky-600 dark:text-sky-400 uppercase">Classroom Teaching</span>
            <h3 class="font-bold text-sm text-zinc-950 dark:text-white">Direct Instruction Blocks</h3>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Standard 50-minute or 90-minute periods requiring active student engagement, board work, and lab management.
            </p>
          </div>
          <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50 space-y-2">
            <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 uppercase">Protected Planning</span>
            <h3 class="font-bold text-sm text-zinc-950 dark:text-white">Prep &amp; Grading Hours</h3>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Essential non-instructional blocks dedicated to rubric grading, lesson preparation, and parent correspondence.
            </p>
          </div>
          <div class="p-5 rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/70 dark:bg-zinc-900/50 space-y-2">
            <span class="text-xs font-mono font-bold text-amber-600 dark:text-amber-400 uppercase">Administrative Duties</span>
            <h3 class="font-bold text-sm text-zinc-950 dark:text-white">Supervision &amp; Faculty Duty</h3>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Staggered cafeteria duty, bus arrival supervision, department curriculum meetings, and IEP collaboration.
            </p>
          </div>
        </div>
      </section>

      <!-- Sample Teacher Week Blueprint -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">
          Sample High School Teacher Weekly Timetable Blueprint
        </h2>
        <p class="font-medium text-zinc-900 dark:text-zinc-100">
          A well-engineered high school teacher timetable clusters common subject preparations, protects daily uninterrupted planning periods, clearly demarcates duty shifts, and provides a clear visual rhythm for classroom management.
        </p>
        <p>
          The table below demonstrates how a secondary mathematics teacher structures a 7-period instructional day in Schedule Studio:
        </p>

        <div class="w-full overflow-x-auto not-prose">
          <table class="w-full text-left text-xs sm:text-sm border-collapse rounded-2xl overflow-hidden border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215]">
            <thead class="bg-zinc-100/70 dark:bg-zinc-850/80 border-b border-zinc-200 dark:border-zinc-800 font-mono text-[11px] uppercase text-zinc-500">
              <tr>
                <th class="py-3 px-4">Period</th>
                <th class="py-3 px-4">Time Window</th>
                <th class="py-3 px-4">Assignment / Course</th>
                <th class="py-3 px-4">Type</th>
                <th class="py-3 px-4">Room / Location</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/60 font-sans">
              <tr>
                <td class="py-3.5 px-4 font-mono font-bold text-zinc-400">Morning</td>
                <td class="py-3.5 px-4 font-mono text-zinc-600 dark:text-zinc-400">07:35 – 07:55 AM</td>
                <td class="py-3.5 px-4 font-semibold text-zinc-900 dark:text-white">Morning Bus Arrival Duty</td>
                <td class="py-3.5 px-4 font-mono text-amber-600 dark:text-amber-400 text-xs">Campus Supervision</td>
                <td class="py-3.5 px-4 font-mono text-xs">Main Entrance</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-mono font-bold text-sky-600 dark:text-sky-400">Period 1</td>
                <td class="py-3.5 px-4 font-mono text-zinc-600 dark:text-zinc-400">08:00 – 08:50 AM</td>
                <td class="py-3.5 px-4 font-semibold text-zinc-900 dark:text-white">Algebra I (Honors)</td>
                <td class="py-3.5 px-4 font-mono text-sky-600 dark:text-sky-400 text-xs">Direct Instruction</td>
                <td class="py-3.5 px-4 font-mono text-xs">Room 204</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-mono font-bold text-sky-600 dark:text-sky-400">Period 2</td>
                <td class="py-3.5 px-4 font-mono text-zinc-600 dark:text-zinc-400">08:55 – 09:45 AM</td>
                <td class="py-3.5 px-4 font-semibold text-zinc-900 dark:text-white">Algebra I (Standard)</td>
                <td class="py-3.5 px-4 font-mono text-sky-600 dark:text-sky-400 text-xs">Direct Instruction</td>
                <td class="py-3.5 px-4 font-mono text-xs">Room 204</td>
              </tr>
              <tr class="bg-emerald-50/50 dark:bg-emerald-950/20">
                <td class="py-3.5 px-4 font-mono font-bold text-emerald-600 dark:text-emerald-400">Period 3</td>
                <td class="py-3.5 px-4 font-mono text-zinc-600 dark:text-zinc-400">09:50 – 10:40 AM</td>
                <td class="py-3.5 px-4 font-semibold text-emerald-900 dark:text-emerald-200">Teacher Prep &amp; Planning Block</td>
                <td class="py-3.5 px-4 font-mono text-emerald-600 dark:text-emerald-400 text-xs font-bold">Protected Prep</td>
                <td class="py-3.5 px-4 font-mono text-xs">Math Office</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-mono font-bold text-sky-600 dark:text-sky-400">Period 4</td>
                <td class="py-3.5 px-4 font-mono text-zinc-600 dark:text-zinc-400">10:45 – 11:35 AM</td>
                <td class="py-3.5 px-4 font-semibold text-zinc-900 dark:text-white">Geometry (Standard)</td>
                <td class="py-3.5 px-4 font-mono text-sky-600 dark:text-sky-400 text-xs">Direct Instruction</td>
                <td class="py-3.5 px-4 font-mono text-xs">Room 204</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-mono font-bold text-zinc-400">Lunch</td>
                <td class="py-3.5 px-4 font-mono text-zinc-600 dark:text-zinc-400">11:40 – 12:15 PM</td>
                <td class="py-3.5 px-4 font-semibold text-zinc-900 dark:text-white">Duty-Free Teacher Lunch</td>
                <td class="py-3.5 px-4 font-mono text-zinc-500 text-xs">Break</td>
                <td class="py-3.5 px-4 font-mono text-xs">Faculty Lounge</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-mono font-bold text-sky-600 dark:text-sky-400">Period 5</td>
                <td class="py-3.5 px-4 font-mono text-zinc-600 dark:text-zinc-400">12:20 – 01:10 PM</td>
                <td class="py-3.5 px-4 font-semibold text-zinc-900 dark:text-white">Geometry (Honors)</td>
                <td class="py-3.5 px-4 font-mono text-sky-600 dark:text-sky-400 text-xs">Direct Instruction</td>
                <td class="py-3.5 px-4 font-mono text-xs">Room 204</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-mono font-bold text-sky-600 dark:text-sky-400">Period 6</td>
                <td class="py-3.5 px-4 font-mono text-zinc-600 dark:text-zinc-400">01:15 – 02:05 PM</td>
                <td class="py-3.5 px-4 font-semibold text-zinc-900 dark:text-white">AP Calculus AB</td>
                <td class="py-3.5 px-4 font-mono text-sky-600 dark:text-sky-400 text-xs">Direct Instruction</td>
                <td class="py-3.5 px-4 font-mono text-xs">Room 204</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-mono font-bold text-purple-600 dark:text-purple-400">Period 7</td>
                <td class="py-3.5 px-4 font-mono text-zinc-600 dark:text-zinc-400">02:10 – 03:00 PM</td>
                <td class="py-3.5 px-4 font-semibold text-zinc-900 dark:text-white">Student Advisory / Academic Support</td>
                <td class="py-3.5 px-4 font-mono text-purple-600 dark:text-purple-400 text-xs">Office Hours</td>
                <td class="py-3.5 px-4 font-mono text-xs">Room 204</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Four Tactical Rules for Educator Schedules -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">
          Four Best Practices to Defend Teacher Planning Time
        </h2>
        <p class="font-medium text-zinc-900 dark:text-zinc-100">
          To protect your professional teaching time, treat your prep periods as scheduled non-negotiable appointments, visually post your room schedule to reduce student walk-in interruptions, create separate Plan A and Plan B layouts for testing weeks, and sync all school calendar events with your personal phone.
        </p>

        <div class="space-y-3 pt-2">
          <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] space-y-1.5">
            <h3 class="text-base font-bold text-zinc-950 dark:text-white flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0" />
              <span>1. Guard Planning Periods Against Meeting Encroachment</span>
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              When administration or colleagues ask "Are you free Period 3?", educators without a visual schedule often say yes and lose their only grading window. Color your prep period in Schedule Studio to designate it as an active working block for lesson design and rubric grading.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] space-y-1.5">
            <h3 class="text-base font-bold text-zinc-950 dark:text-white flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0" />
              <span>2. Print Classroom Door Postings for Student &amp; Visitor Clarity</span>
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Students, counselors, and substitute teachers need to know where you are at any given hour. Export a clean A4 PDF from Schedule Studio, laminate it, and display it beside your classroom doorway so wandering students know exactly when your office hours begin.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] space-y-1.5">
            <h3 class="text-base font-bold text-zinc-950 dark:text-white flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0" />
              <span>3. Establish Substitute Teacher Folder Blueprints</span>
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              When taking a sick day or attending professional development, substitute teachers struggle with confusing bell schedules. An annotated Schedule Studio printout with exact start/end times and emergency room keys guarantees your classroom runs smoothly in your absence.
            </p>
          </div>

          <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#121215] space-y-1.5">
            <h3 class="text-base font-bold text-zinc-950 dark:text-white flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-500 shrink-0" />
              <span>4. Batch Grading and Student Task Management</span>
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Use the built-in Task Manager in Schedule Studio alongside your weekly grid. Pair specific grading targets (e.g. "Grade Period 1 Honors Quizzes") directly with Period 3 planning time to eliminate evening grading marathons at home.
            </p>
          </div>
        </div>
      </section>

      <!-- Printing and Customizing -->
      <section class="space-y-4">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-white">
          Exporting and Printing Your Classroom Schedule
        </h2>
        <p class="font-medium text-zinc-900 dark:text-zinc-100">
          To export and print your teacher schedule, arrange your instructional periods and prep windows in Schedule Studio, click 'Export Hub', and download a printer-ready vector PDF formatted for US Letter or A4 dimensions. You can also export an iCal (.ICS) calendar file to synchronize your school schedule directly with Microsoft Outlook or Google Calendar on your phone.
        </p>
        <p>
          Additionally, you can generate a high-resolution lockscreen wallpaper image so you can check hallway passing times and room numbers with a quick glance at your phone screen between classes.
        </p>
      </section>

    </article>

    <!-- FAQ Section with Schema Support -->
    <section class="space-y-6 pt-6 border-t border-zinc-200 dark:border-zinc-800">
      <div class="space-y-2">
        <span class="text-xs font-mono uppercase tracking-wider text-zinc-500">Educator Questions</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-zinc-950 dark:text-white">
          Teacher Schedule &amp; Classroom Management FAQ
        </h2>
        <p class="text-xs text-zinc-600 dark:text-zinc-400">
          Practical strategies for K-12 teachers on classroom bell schedules, prep time boundaries, and digital calendar sync.
        </p>
      </div>

      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/40 p-4 sm:p-5 transition-all [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between text-xs sm:text-sm font-bold text-zinc-950 dark:text-white select-none">
              <span>{faq.q}</span>
              <span class="ml-4 shrink-0 text-zinc-400 group-open:rotate-180 transition-transform duration-200 text-xs">
                ▼
              </span>
            </summary>
            <div class="mt-3 text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-400 border-t border-zinc-200/60 dark:border-zinc-800/60 pt-3">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Bottom Conversion CTA -->
    <footer class="p-8 sm:p-12 rounded-3xl bg-zinc-950 text-white dark:bg-white dark:text-zinc-950 text-center space-y-4 shadow-sm">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
        Build Your Teacher Schedule in Under 2 Minutes
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400 dark:text-zinc-600 max-w-xl mx-auto leading-relaxed">
        100% free, private, and customizable in your browser. Organize your classroom periods, protect your prep time, and print your door postings today.
      </p>
      <div class="pt-2">
        <a 
          href="/app" 
          class="h-12 px-6 rounded-xl bg-white text-zinc-950 hover:bg-zinc-100 dark:bg-zinc-950 dark:text-white dark:hover:bg-zinc-900 font-bold text-sm inline-flex items-center justify-center gap-2 transition shadow-sm"
        >
          <span>Open Schedule Studio Now &rarr;</span>
        </a>
      </div>
    </footer>

  </div>
</Layout>

